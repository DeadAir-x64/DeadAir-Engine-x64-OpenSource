# exclude all dot files except .git, appveyor and travis files
.*
!.git*
!.appveyor*
!.editorconfig
!.vscode

# exclude binaries and temporary files
[Bb]in/
[Bb]uild*/

# User-specific files
*.user
*.user.props
*.nvuser
*.PVS-Studio.*

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# exclude doxygen output
doc/doxygen/html/*

# xray-monolith donor reference (read-only)
scratchpad/

# [DA_PORT] Сторонние SDK: у каждого свой .git и своя лицензия, в дерево порта они не входят.
# NVIDIA DLSS  — git clone --depth 1 https://github.com/NVIDIA/DLSS.git Externals/nvngx   (~760 МБ)
# Intel XeSS   — git clone --depth 1 https://github.com/intel/xess.git Externals/xess
# Собранная прослойка da_ngx.dll лежит в Externals/nvngx_shim и коммитится: она наша.
Externals/nvngx/
Externals/xess/

# [DA_PORT] Символы для расшифровки стеков крашей — 2.5 ГБ выгрузок, восстанавливаются сборкой
da_port/symbols/

# [DA_PORT] Кэш интерпретатора Python от наших инструментов
__pycache__/
*.pyc
