#include "common.h"

// [DA_PORT] One Load that works whether or not the G-buffer is multisampled.
//
// Texture2DMS::Load takes (int2 pixel, int sample) - there is no one-argument form, so the plain
// int3 call below fails to COMPILE under USE_MSAA, and a shader that fails to compile is silently
// replaced with stub_default. Sample 0 is the right answer here: these passes ask about geometry
// presence and depth, not about coverage inside a pixel.
#ifndef USE_MSAA
#	define DA_LOAD_GBUF(tex, px) tex.Load(px)
#else
#	define DA_LOAD_GBUF(tex, px) tex.Load((px).xy, 0)
#endif


// [DA_PORT] Give the sky its motion vectors.
//
// The sky is drawn by sky2.vs/ps into two colour targets of its own - it never touches the G-buffer,
// so it cannot write velocity even in principle, and the velocity buffer keeps the zero it was cleared
// to. Zero does not mean "unknown" to an upscaler: it means "this pixel did not move on screen". So
// every time the player turns, the whole sky is reconstructed from history fetched where it used to
// be, and the result is the shimmer along the horizon and through thin things drawn against it.
//
// The correct vector is analytic and needs no geometry. The sky has no parallax - walking does not
// change it - so only the camera's ROTATION moves it, and that is exactly what reprojecting a point
// far along this pixel's ray through the previous camera gives. Twenty kilometres is what da_taa.ps
// uses for the same purpose; at that distance the translation contributes less than a hundredth of a
// pixel and only the rotation survives.
//
// Written as a separate pass rather than added to the sky shader because it must land in a target that
// pass does not have. Non-sky pixels are discarded, so the buffer keeps everything the G-buffer wrote
// and this never has to read what it writes.

#define DA_SKY_DEPTH 20000.0

struct vf
{
	float2 tc0   : TEXCOORD0;
	float4 hpos  : SV_Position;
};

uniform float4x4 m_prev_VP;  // eye-space -> previous frame's un-jittered clip space

float4 main(vf I) : SV_Target
{
	const int3 px = int3(I.hpos.xy, 0);

	// .z == 0 is where no geometry was drawn. That is the sky, and the only place this pass may write.
	const float eye_z = DA_LOAD_GBUF(s_position, px).z;
	clip(0.001 - abs(eye_z));

	// The eye-space ray through this pixel, rebuilt the way every deferred shader rebuilds it.
	const float2 sp = float2(px.xy) + 0.5;
	const float3 ray = float3(sp * pos_decompression_params.zw - pos_decompression_params.xy, 1.0);

	const float4 prev = mul(m_prev_VP, float4(ray * DA_SKY_DEPTH, 1.0));
	if (prev.w <= 0.0001)
		return float4(0, 0, 0, 0);

	// Current NDC straight out of the ray, without needing the resolution: pos_decompression_params.xy
	// is the tangent of the half-FOV, which is what the ray was scaled by. The y sign flips because
	// pixel rows count downwards and clip space counts up.
	const float2 ndc_now = float2(ray.x / pos_decompression_params.x, -ray.y / pos_decompression_params.y);
	const float2 ndc_prev = prev.xy / prev.w;

	return float4(ndc_now - ndc_prev, 0, 0);
}
