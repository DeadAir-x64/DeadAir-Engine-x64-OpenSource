; Dead Air x64 — «Установки качества»: МАКСИМАЛЬНЫЕ.
;
; Пять файлов rspec_*.ltx стоят за списком «Установки качества» в настройках видео. Движок выполняет
; файл строка за строкой как консольные команды — CCC_Preset, Layers/xrRender/xrRender_console.cpp.
; Это уровень, с которым мод поставляется (`_preset Extreme` в user.ltx).
;
; ⛔ Эти файлы НЕ ПЕРЕСЕКАЮТСЯ с пресетом вкладки «Производительность» (r__perf_preset). Ему
; принадлежат r__light_shadow_budget, r2_sun_far, r2_smap_size, r__optimize_static_geom,
; r__optimize_dynamic_geom, rs_vis_distance, r__detail_radius, r__detail_density, r__geometry_lod,
; r__detail_height — здесь их быть не должно. Полное объяснение состава — в rspec_minimum.ltx.

; --- Солнце ----------------------------------------------------------------------------------------
r2_sun on
r2_sun_quality st_opt_extreme
r2_sun_details on

; --- Свет от ламп -----------------------------------------------------------------------------------
r2_ls_squality 1.0
r2_slight_fade 1.0
ai_use_torch_dynamic_lights on

; --- Полноэкранные проходы --------------------------------------------------------------------------
r2_ssao_mode hbao
r2_ssao st_opt_high
r2_sun_shafts st_opt_high
r2_volumetric_lights on
r3_volumetric_smoke on
r3_dynamic_wet_surfaces on
r3_water_refl st_opt_ultra
r2_dof_enable on

; --- Материалы ---------------------------------------------------------------------------------------
r2_detail_bump on
r2_steep_parallax on
r2_soft_water on
r2_soft_particles on

; --- Текстуры -----------------------------------------------------------------------------------------
; Анизотропия НЕ понижается по уровням качества: под любым апскейлером мы сдвигаем mip LOD bias в
; минус на log2(render/output), и трилинейная фильтрация в этом режиме недосэмплирует — вместо мыла
; получается МЕРЦАНИЕ. Анизотропия берёт отсчёты вдоль длинной оси пятна и делает отрицательный
; сдвиг безопасным. Замерено на DLSS: x16 убирает мелькание. Стоит она на DX11-железе копейки.
r__tf_aniso 16
texture_lod 0
r2_tf_mipbias 0

; --- Прочее -------------------------------------------------------------------------------------------
r__wallmark_ttl 60
rs_skeleton_update 32
ph_iterations 18
snd_cache_size 32
snd_targets 256

; --- Заведомо выключенное ------------------------------------------------------------------------------
r2_gi off
