; Dead Air x64 — компромиссный набор: заметный прирост при почти неизменной картинке.
;
; Применить из консоли:   cfg_load da_port_balanced.ltx
;
; Для машин, которым «высокие» настройки тяжеловаты, но резать всё подряд не хочется. По сравнению с
; da_port_lowend.ltx здесь сохранены тени, затенение и мягкая вода — срезано то, что стоит дорого и
; видно мало.

; Сцена в 85% разрешения. На глаз почти неотличимо от 100 благодаря бикубическому растягиванию, а
; пикселей на четверть меньше.
r__render_scale 85

; Темпоральное сглаживание вместо MSAA — дешевле и стабильнее на растительности.
r3_msaa st_opt_off
r__taa 1
r__taa_sharp 35

; Тени: средний размер карты вместо максимального.
r2_smap_size 2048
r2_sun_quality st_opt_medium

; Затенение оставлено, но самое дешёвое из доступных.
r2_ssao_mode default
r2_ssao st_opt_low

; Объёмный свет — самая дорогая из «красивых» опций, её убираем первой.
r2_volumetric_lights off

; Трава: радиус — это и видеокарта, и процессор.
r__detail_radius 100

; Мягкая вода и частицы оставлены: в Dead Air много воды, и без них она выглядит заметно хуже.
r2_soft_water on
r2_soft_particles on

r2_steep_parallax off

; Анизотропия остаётся максимальной: под апскейлером сдвиг мип-уровней уходит в минус, и низкая
; анизотропия даёт не мыло, а мерцание (подробнее — в da_port_lowend.ltx).
r__tf_aniso 16
