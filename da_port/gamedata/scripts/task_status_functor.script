
function drx_sl_money_task_status( tsk, task_id )

	if not ( db.actor ) then
		return
	end

	if ( db.actor:money( ) >= tonumber( alun_utils.load_var( db.actor, (task_id .. "_fetch"), 0 ) ) ) then
		tsk.stage = 1
	else
		tsk.stage = 0
	end

end


function drx_sl_assault_mutant_task_status( tsk, task_id )

	if not ( db.actor ) then
		return
	end

	if ( tsk.stage == 1 ) then -- already completed
		return
	end

	local smart_id = alun_utils.load_var(db.actor, (task_id .. "_id") )
	if not ( smart_id ) then
		return "fail"
	end

	local smrt = SIMBOARD.smarts[smart_id]
	if not ( smrt ) then
		return "fail"
	end

	local smart = smrt.smrt
	if not ( smart ) then
		return "fail"
	end

	local smart_online = (smart.position:distance_to_sqr(db.actor:position()) <= alife():switch_distance()^2)
		
	--in case sim_avail is set true during the player's tsk
	if not( smart.sim_avail == nil or xr_logic.pick_section_from_condlist( actor, smart, smart.sim_avail ) == "true" ) then
		return "fail"
	end

	local tg = time_global( )
	if ( tsk.__check_smart_time and tg < tsk.__check_smart_time ) then
		return
	end
	tsk.__check_smart_time = (tg + 3000)

	alun_utils.save_var( db.actor, (task_id .. "_target_id"), nil )

	if ( smart.sim_avail == nil or xr_logic.pick_section_from_condlist( actor, smart, smart.sim_avail ) == "true" ) then
		for id,squad in pairs( SIMBOARD.squads ) do
			if ( squad ) and simulation_objects.is_on_the_same_level( squad, smart ) then
				if not ( squad.first_update ) then
					return -- not all squads are loaded yet!
				end
				if (squad.current_target_id and squad.current_target_id == smart.id and squad.current_action == 1) then

					if (is_squad_monster[squad.player_id]) and not (string.find(squad:name(),"simulation_tushkano") or string.find(squad:name(),"simulation_rat")) then
						alun_utils.save_var( db.actor, (task_id .. "_target_id"), squad.id )
						squad.stay_time = game.get_game_time( ) -- reset gametime so they don't leave
						return
					end

				end
			end
		end
	end
	
	smart.faction = nil
	
	if not (smart_online) then 
		return "fail" 
	end

	if ( tsk.stage == 0 ) then
		tsk.stage = 1
	end

end

function drx_sl_assault_zombied_task_status( tsk, task_id )

	if not ( db.actor ) then
		return
	end

	if ( tsk.stage == 1 ) then -- already completed
		return
	end

	local smart_id = alun_utils.load_var(db.actor, (task_id .. "_id") )
	if not ( smart_id ) then
		return "fail"
	end

	local smrt = SIMBOARD.smarts[smart_id]
	if not ( smrt ) then
		return "fail"
	end

	local smart = smrt.smrt
	if not ( smart ) then
		return "fail"
	end

	--in case sim_avail is set true during the player's tsk
	if not( smart.sim_avail == nil or xr_logic.pick_section_from_condlist( actor, smart, smart.sim_avail ) == "true" ) then
		return "fail"
	end

	local tg = time_global( )
	if ( tsk.__check_smart_time and tg < tsk.__check_smart_time ) then
		return
	end
	tsk.__check_smart_time = (tg + 3000)

	alun_utils.save_var( db.actor, (task_id .. "_target_id"), nil )

	if ( smart.sim_avail == nil or xr_logic.pick_section_from_condlist( actor, smart, smart.sim_avail ) == "true" ) then
		for id,squad in pairs( SIMBOARD.squads ) do
			if ( squad ) and simulation_objects.is_on_the_same_level( squad, smart ) then
				if not ( squad.first_update ) then
					return -- not all squads are loaded yet!
				end
				if (squad.current_target_id and squad.current_target_id == smart.id and squad.current_action == 1) then

					if (squad.player_id == "zombied") and not is_squad_monster[squad.player_id] then
						alun_utils.save_var( db.actor, (task_id .. "_target_id"), squad.id )
						squad.stay_time = game.get_game_time( ) -- reset gametime so they don't leave
						return
					end

				end
			end
		end
	end

	smart.faction = nil
	
	if ( tsk.stage == 0 ) then
		tsk.stage = 1
	end

end

function drx_sl_assault_task_status( tsk, task_id )

	if not ( db.actor ) then
		return
	end
	
	
	if ( tsk.stage == 1 ) then -- already completed
		return
	end

	local smart_id = alun_utils.load_var(db.actor, (task_id .. "_id") )
	if not ( smart_id ) then
		return "fail"
	end

	local smrt = SIMBOARD.smarts[smart_id]
	if not ( smrt ) then
		return "fail"
	end

	local smart = smrt.smrt
	if not ( smart ) then
		return "fail"
	end
	
	--in case sim_avail is set true during the player's tsk
	if not( smart.sim_avail == nil or xr_logic.pick_section_from_condlist( actor, smart, smart.sim_avail ) == "true" ) then
		return "fail"
	end

	-- Get tsk giver faction:
	local task_giver_faction = alun_utils.parse_list( task_manager.task_ini, task_id, "status_functor_params" )
	if ( #task_giver_faction < 1 ) then
		printf( "DRX SL Error: drx_sl_assault_task_status not supplied with tsk giver faction in status functor !!!" )
		return "fail"
	end

	-- List of all factions:
	local factions_list = {
		"stalker",
		"dolg",
		"freedom",
		"csky",
		"ecolog",
		"killer",
		"army",
		"bandit",
		"monolith"
	}
	
	-- Build list of mutual enemy factions:
	local enemy_faction_list = {}
	for i = 1, #factions_list do
		if ( game_relations.is_factions_enemies( factions_list[i], task_giver_faction[1] ) ) then
			table.insert( enemy_faction_list, factions_list[i] )
		end
	end

	-- Ensure an enemy faction was found:
	if ( #enemy_faction_list < 1 ) then
		printf( "DRX SL Error: drx_sl_assault_task_status failed, no enemy factions found !!!" )
		return "fail"
	end

	local tg = time_global( )
	if ( tsk.__check_smart_time and tg < tsk.__check_smart_time ) then
		return
	end
	tsk.__check_smart_time = (tg + 3000)

	alun_utils.save_var( db.actor, (task_id .. "_target_id"), nil )

	if ( smart.sim_avail == nil or xr_logic.pick_section_from_condlist( actor, smart, smart.sim_avail ) == "true" ) then
		for id,squad in pairs( SIMBOARD.squads ) do
			if ( squad ) and simulation_objects.is_on_the_same_level( squad, smart ) then
				if not ( squad.first_update ) then
					return -- not all squads are loaded yet!
				end
				if (squad.current_target_id and squad.current_target_id == smart.id and squad.current_action == 1) then
					for i = 1, #enemy_faction_list do
						if ( squad.player_id == enemy_faction_list[i] ) then
							alun_utils.save_var( db.actor, (task_id .. "_target_id"), squad.id )
							alun_utils.save_var( db.actor, (smart.id .. "_assault_target"), true )
							squad.stay_time = game.get_game_time( ) -- reset gametime so they don't leave
							squad.force_online = true
							return
						end
					end
				end
			end
		end
	end

	smart_faction = nil

	if not (smart.online) then return "fail" end
	
	if ( tsk.stage == 0 ) then
	
		alun_utils.save_var( db.actor, (smart.id .. "_assault_target"), nil )
		
		local id = tsk.task_giver_id
		local se_obj = id and alife():object(id)
		local giver_smart = se_obj and se_obj.m_smart_terrain_id and se_obj.m_smart_terrain_id ~= 65535 and alife():object(se_obj.m_smart_terrain_id)
	
		--printf("!"..tostring(giver_smart:name()))
	
		if (giver_smart) then
			printf("-new squad")
			smart.faction = task_giver_faction[1]
			if task_giver_faction[1] == "killer" then
			    local new_squad = SIMBOARD:create_squad(giver_smart, "merc_sim_squad_advanced")
				if (new_squad) then
				    printf("-created")
				    new_squad.scripted_target = smart:name()
				end
			else
			    local new_squad = SIMBOARD:create_squad(giver_smart,task_giver_faction[1].."_sim_squad_advanced")
			    if (new_squad) then
				    printf("-created")
				    new_squad.scripted_target = smart:name()
			    end
		    end
		end
		
		tsk.stage = 1
	end

end

