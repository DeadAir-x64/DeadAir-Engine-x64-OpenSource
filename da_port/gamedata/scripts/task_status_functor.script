		return
	end

	local total_loot_count, npc
	for k in squad:squad_members() do
		local npc = db.storage[k.id] and db.storage[k.id].object
		if (npc) then
			total_loot_count = total_loot_count + (utils.load_var(npc,"s_loot_count") or 0)
		end
	end

	if (total_loot_count >= tonumber(p[2] or 5)) then
		return "complete"
	end
end

function kill_scripted_squad_task_status(tsk,task_id)
		
	if not (db.actor) then
		return
	end

	if (tsk.stage == 0) then
	
		local params = alun_utils.parse_list(task_manager.task_ini,task_id,"status_functor_params")
		local target = params[1]
	
		if (not xr_conditions.squad_exist(nil,nil,{target})) then
			tsk.stage = 1
		end	
	end
end

function task_type_ecolog_gathered_tissue_samples(tsk,task_id)
	if (db.actor and tsk.stage == 0) then
		local count = utils.load_var(db.actor,task_id.."_tissue_count",0)
		local need = utils.load_var(db.actor,task_id.."_tissue_need",0)

		if (count >= need) then
			tsk.stage = 1
		else
			tsk.stage = 0
		end
	end
	return
end


function esc_m_trader_task_status_1(tsk,task_id)
		
	if not (db.actor) then
		return
	end

	if (tsk.stage == 0) then
		if (not xr_conditions.squad_exist(nil,nil,{"bandit_esc_smart_terrain_7_11"})) then
			tsk.stage = 1
		end	
	end
end

function ds2_gonta_quest_task_status(tsk,task_id)
		
	if not (db.actor) then
		return
	end

	if (tsk.stage == 0) then
	
		local start_time = utils.load_ctime(db.actor,(task_id .. "_date"))
		local diff = game.get_game_time():diffSec(start_time)/60/60

		if not (level.get_time_hours() > 4 and level.get_time_hours() < 19) then
			give_info("gonta_quest_time")
		else
			disable_info("gonta_quest_time")
			if (diff > 18) or (db.actor:has_info("gonta_quest_moved")) then
				dialogs.ds2_set_gonta_remove()
				disable_info("gonta_quest_moved")
				give_info("gonta_quest_failed")
				return "fail"
			end
		end
		
		if (not xr_conditions.squad_exist(nil,nil,{"ds2_lager_st_bandit_squad"})) then
			give_info("gonta_quest_finished")
			
			
			if (db.actor:has_info("gonta_quest_moved")) then
				disable_info("gonta_quest_moved")
			else
				disable_info("gonta_quest_time")
			end
			tsk.stage = 1
		end	
	end
	
	if (db.actor:has_info("gonta_quest_closed")) then
		return "complete"
	end
end

--------------------------------------------------------------
function kill_strelok(tsk,task_id)
	local squad = get_story_squad("legendary_strelok")
	if (squad) then
		for k in squad:squad_members() do
			local se_obj = alife_object(k.id)
			if (se_obj and not se_obj:alive()) then
				return "complete"
			end
		end
	end
end

function has_alife_info(tsk,task_id)
	if tsk.stage ~= 0 then return end
	local p = alun_utils.parse_list( task_manager.task_ini, task_id, "status_functor_params" )
	if (db.actor:has_info(p[1])) then
		tsk.stage = 1
	end
end