
-- [DA_PORT] Keep played sounds alive until they finish.
--
-- Each sound below was created into a LOCAL, played, and then dropped: the variable leaves scope, Lua's
-- collector takes the object, and CScriptSound's destructor calls destroy() on a sound that is still
-- playing. The engine reports it itself - "Playing sound is not completed, but is destroying ..." - and
-- audibly the sound is cut off part-way, at whatever moment the collector happens to run.
--
-- A ring rather than one slot: several of these overlap in practice, and a single variable would cut
-- the previous sound the moment the next one starts. Bounded, so nothing accumulates.
local da_snd_ring, da_snd_pos = {}, 0
local function da_keep(snd)
	da_snd_pos = da_snd_pos % 8 + 1
	da_snd_ring[da_snd_pos] = snd
	return snd
end

