		unlock_article("encyclopedia_documents_letter_memoirs_1_of_2")
		give_info("encyclopedia_documents_letter_memoirs_1_of_2")
	end
	
	if (item:section() == "letter_memoirs_2_of_2") and not (db.actor:has_info("encyclopedia_documents_letter_memoirs_2_of_2")) then
		unlock_article("encyclopedia_documents_letter_memoirs_2_of_2")
