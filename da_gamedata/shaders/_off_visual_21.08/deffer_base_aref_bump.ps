//Большая часть листвы на деревьях, кусты

#if ( defined(MSAA_ALPHATEST_DX10_1_ATOC) || defined(MSAA_ALPHATEST_DX10_1) ) 
#define EXTEND_F_DEFFER
#endif

#include "common.h"
#include "da_shader_ids.h"
// [DA_PORT] Разрыв повторов разрешён ТОЛЬКО этому шейдеру. Разбор — в da_hextile.h.
//
// Дефайн обязан стоять ДО sload.h. Приём годится лишь там, где развёртка тайловая: у
// импосторов и дальних болванок текстура лежит АТЛАСОМ, у частиц — тем более, и случайный
// сдвиг взял бы там кусок из соседней ячейки. Проверено на бочке: каша.
#define DA_HEX_ALLOW 1
#include "sload.h"

#ifdef	ATOC

float4 	main	( p_bumped I ) : SV_Target
{
	surface_bumped 	S 		= sload 	(I);
	S.base.w = (S.base.w-def_aref*0.5f)/(1-def_aref*0.5f);
	return S.base;
}

#else	//	ATOC

#ifdef	MSAA_ALPHATEST_DX10_1_ATOC
f_deffer 	main	( p_bumped I, float4 pos2d : SV_Position )
#else	//	MSAA_ALPHATEST_DX10_1_ATOC
f_deffer 	main	( p_bumped I )
#endif	//	MSAA_ALPHATEST_DX10_1_ATOC
{
	f_deffer		O;

#if !defined(MSAA_ALPHATEST_DX10_1)
	surface_bumped 	S 		= sload 	(I);

#if	!( defined(MSAA_ALPHATEST_DX10_1_ATOC) || defined(MSAA_ALPHATEST_DX10_0_ATOC) )
	clip					(S.base.w-def_aref);
#endif	//	!( defined(MSAA_ALPHATEST_DX10_1_ATOC) || defined(MSAA_ALPHATEST_DX10_1_ATOC) )
#ifdef 	MSAA_ALPHATEST_DX10_1_ATOC
	float alpha = (S.base.w-def_aref*0.5f)/(1-def_aref*0.5f);
	uint mask = alpha_to_coverage ( alpha, pos2d );
#endif	//	MSAA_ALPHATEST_DX10_1_ATOC

#else	//	!defined(MSAA_ALPHATEST_DX10_1)
	uint mask = 0x0;
	
	surface_bumped 	S 		= sload 	(I,MSAAOffsets[0]*(1.0/16.0));
	
	if( S.base.w-def_aref >= 0 ) mask |= 0x1;
	
	[unroll] for( int i = 1; i < MSAA_SAMPLES; ++i )
	{
		surface_bumped 	SI 		= sload 	(I,MSAAOffsets[i]*(1.0/16.0));
		if( SI.base.w-def_aref >= 0 ) mask |= ( uint(0x1) << i );
	}
	
	if( mask == 0x0 )
		discard;
#endif	//	!defined(MSAA_ALPHATEST_DX10_1)

	// Sample normal, rotate it by matrix, encode position 
  	float3	Ne  = mul		(float3x3(I.M1, I.M2, I.M3), S.normal);
			Ne	= normalize	(Ne);

	// hemi,sun,material
	float 	ms	= xmaterial		;
#ifdef USE_LM_HEMI
//	float4	lm 	= tex2D			(s_hemi, I.lmh);
	float4	lm 	= s_hemi.Sample( smp_rtlinear, I.lmh);
	//float 	h  	= dot			(lm.rgb,1.h/3.h);
	float 	h  	= get_hemi(lm);
# ifdef USE_R2_STATIC_SUN
//		 	ms 	= lm.w;
			ms 	= get_sun(lm);
# endif
#else
	float 	h	= I.position.w	;
# ifdef USE_R2_STATIC_SUN
		 	ms	= I.tcdh.w		;
# endif
#endif

S.base.xyz = Vibrance(S.base.xyz, 1.3);
	// [DA_PORT] Фильтрация блика: приглушаем пик там, где нормаль внутри пикселя уже не разрешается.
	// При r__spec_aa 0 множитель равен единице. Отладка: 1 — сам множитель, 2 — снятое.
	float da_saa = da_spec_aa_factor( Ne );
	S.gloss *= da_saa;
	if (da_spec_aa.w > 0.5h)
		S.base.xyz = (da_spec_aa.w < 1.5h) ? da_saa.xxx : (1.0h - da_saa).xxx;

	// [DA_PORT] Собственная тень рельефа — в альбедо, см. разбор в deffer_base_bump.ps и sload.h.
	// Без крутого параллакса множитель равен единице. Отладочной раскраски здесь намеренно нет:
	// шейдер рисует листву и кусты, параллакса на них не бывает, и красить их значило бы мешать.
	S.base.rgb *= da_parallax_shadow;
	// И блеск — иначе поверхность читается зеркальной, разбор в deffer_base_bump.ps.
	S.gloss *= da_parallax_shadow;


#ifndef EXTEND_F_DEFFER
	O = pack_gbuffer(
						float4	(Ne,										h*H_BUSHES),
  						float4 	(I.position.xyz + Ne*S.height*def_virtualh, ms),
  						float4	(S.base.x,S.base.y,S.base.z,				S.gloss) );
#else
	O = pack_gbuffer(
						float4	(Ne,										h*H_BUSHES),
  						float4 	(I.position.xyz + Ne*S.height*def_virtualh, ms),
  						float4	( float3(S.base.x,S.base.y,S.base.z),		S.gloss),
  						mask );
#endif

	// [DA_PORT] Motion vector — see deffer_base_flat.ps.
#ifdef DA_VELOCITY
#ifdef DA_DEBUG_SHADER_IDS
	O.velocity = DA_ID_AREF_BUMP;
#else
	O.velocity = I.hpos_curr.xy / I.hpos_curr.w - I.hpos_old.xy / I.hpos_old.w;
	// [DA_PORT] Moving pixels distrust their history - see da_motion_reactive.
	O.reactive = max( O.reactive, da_motion_reactive(O.velocity) );
#endif
#endif


	// [DA_PORT] Alpha-tested foliage - see deffer_base_aref_flat.ps for why this pixel must not be
	// blended with its own history.
#ifdef DA_VELOCITY
	O.reactive = m_taa_jitter.z; // [DA_PORT] r__reactive_foliage
#endif
	return 	O	;
}

#endif //	ATOC
