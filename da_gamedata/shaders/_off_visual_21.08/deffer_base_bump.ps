#include "common.h"
#include "da_shader_ids.h"
// [DA_PORT] Разрыв повторов разрешён ТОЛЬКО этому шейдеру. Разбор — в da_hextile.h.
//
// Дефайн обязан стоять ДО sload.h. Приём годится лишь там, где развёртка тайловая: у
// импосторов и дальних болванок текстура лежит АТЛАСОМ, у частиц — тем более, и случайный
// сдвиг взял бы там кусок из соседней ячейки. Проверено на бочке: каша.
#define DA_HEX_ALLOW 1
#include "sload.h"

f_deffer main ( p_bumped I )
{
  f_deffer	O;

  surface_bumped 	S 	= sload 	(I);

  // Sample normal, rotate it by matrix, encode position 
  float3 Ne				= mul       (float3x3(I.M1, I.M2, I.M3), S.normal);
			Ne				= normalize	(Ne);

	// hemi,sun,material
	float 	ms	= xmaterial		;
#ifdef USE_LM_HEMI
//	float4	lm 	= tex2D			(s_hemi, I.lmh);
	float4	lm 	= s_hemi.Sample( smp_rtlinear, I.lmh);
//	float 	h  	= dot			(lm.rgb,1.h/3.h);
	float 	h  	= get_hemi(lm);
# ifdef USE_R2_STATIC_SUN
//		 	ms 	= lm.w;
			ms 	= get_sun(lm);
# endif
#else
	float 	h	= I.position.w	;
# ifdef USE_R2_STATIC_SUN
		 	ms	= I.tcdh.w		;
# endif
#endif

	S.base.xyz = Vibrance(S.base.xyz, 1.4);
	// [DA_PORT] Фильтрация блика: приглушаем пик там, где нормаль внутри пикселя уже не разрешается.
	// При r__spec_aa 0 множитель равен единице. Отладка: 1 — сам множитель, 2 — снятое.
	float da_saa = da_spec_aa_factor( Ne );
	S.gloss *= da_saa;
	if (da_spec_aa.w > 0.5h)
		S.base.xyz = (da_spec_aa.w < 1.5h) ? da_saa.xxx : (1.0h - da_saa).xxx;

	// [DA_PORT] Собственная тень рельефа — в АЛЬБЕДО. Без крутого параллакса множитель равен единице
	// и строка не меняет ничего.
	//
	// ⚠️ Первая версия множила hemi, и это была ошибка, стоившая целого захода: видно не было НИЧЕГО.
	// Разбор: hemi кормит только рассеянный свет, а тот в combine_1.ps складывается с солнечным
	// (light = L.rgb + hdiffuse). На залитой солнцем стене доля рассеянного мала, и приглушение его
	// на шестую часть терялось в итоговом цвете целиком.
	//
	// Положить тень в солнечную составляющую нельзя: канал mtl несёт её только при USE_R2_STATIC_SUN,
	// а в R4 статическое солнце выключено (xrRender_R4.cpp — оно включается лишь для режима R2A), и
	// там лежит номер материала. Испортить его значит сменить модель освещения. Свободных мест в
	// G-буфере нет вовсе — см. da_parallax_selfshadow в sload.h.
	//
	// Поэтому множим альбедо: тень действует на ВЕСЬ свет сразу. Неверно это тем, что приглушает и
	// свет, пришедший с другой стороны — от фонаря, от костра. Для канавки в кирпиче такое допущение
	// безобидно (она темна почти со всех сторон), а главное — величина считается каждый кадр по
	// настоящему направлению солнца, то есть тень ЕДЕТ вместе с ним, в отличие от запечённой карты
	// полостей, которой этот приём иначе был бы равносилен.
	S.base.rgb *= da_parallax_shadow;
	// ⚠️ И БЛЕСК ТОЖЕ. Без этой строки появляется «зеркальность»: альбедо приглушено, а блик остался
	// прежним, отношение между ними уехало в сторону зеркальной составляющей — и поверхность читается
	// пластиковой. Симптом описан у Лагарда (feeding a physically based shading model): затенённая
	// полость обязана глушить И блик, иначе в углублениях он оказывается сильнее, чем должен.
	//
	// Здесь это ровно один множитель: gloss уезжает в G-буфер как C.w, а combine_1.ps считает блик
	// как C.www*L.rgb*5 — то есть домножение gloss на тень и есть затенение блика.
	S.gloss *= da_parallax_shadow;

	// Отладка: 1 — сама тень, 2 — карта высот в найденной точке, 3 — все пиксели, до которых ветка
	// параллакса вообще дошла. Третий режим отделяет «поправка мала» от «код здесь не выполняется».
	//
	// Режимы 1 и 2 красят ТОЛЬКО пиксели с параллаксом: иначе они забелили бы весь мир (у
	// поверхности без рельефа тень равна единице по определению), и прибор потонул бы в собственном
	// шуме. Режим 3, наоборот, обязан красить всё — он про то, где ветка НЕ отработала.
	if (da_parallax2.w > 0.5h)
	{
		if (da_parallax2.w > 2.5h)
			S.base.xyz = float3( da_parallax_hit, 0.0h, 0.0h );
		else if (da_parallax_hit > 0.5h)
			S.base.xyz = (da_parallax2.w < 1.5h) ? da_parallax_shadow.xxx : da_parallax_height.xxx;
	}

	O			= pack_gbuffer(
										float4	(Ne, 											h*H_MODELS		),
										float4 	(I.position.xyz + Ne*S.height*def_virtualh, ms		),
	//									float4 	(I.position.xyz, ms),
										float4	(S.base.xyz, 										S.gloss	) );

	// [DA_PORT] Motion vector — see deffer_base_flat.ps for why the divide happens here.
#ifdef DA_VELOCITY
#ifdef DA_DEBUG_SHADER_IDS
	O.velocity = DA_ID_BUMP;
#else
	O.velocity = I.hpos_curr.xy / I.hpos_curr.w - I.hpos_old.xy / I.hpos_old.w;
	// [DA_PORT] Moving pixels distrust their history - see da_motion_reactive.
	O.reactive = max( O.reactive, da_motion_reactive(O.velocity) );
#endif
#endif

  return O;
}
