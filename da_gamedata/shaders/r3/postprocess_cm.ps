//////////////////////////////////////////////////////////////////////////////////////////
// Pixel
float4 main( p_postpr I ) : SV_Target
{
	// [DA_PORT] Îòëàäî÷íûå ïîêàçû - äî âñåãî îñòàëüíîãî, ðîâíî êàê â postprocess.ps.
	if (da_upscale.y > 4.5)
		return float4(da_debug_depth(I.Tex0), 1.0h);
	if (da_upscale.y > 3.5)
		return float4(da_debug_reactive(I.Tex0), 1.0h);
	if (da_upscale.y > 1.5)
		return float4(da_debug_velocity(I.Tex0), 1.0h);

#ifdef DA_VELOCITY
	// [DA_PORT] Êàäð ñîáðàë àïñêåéëåð - áåð¸ì ÅÃÎ âûõîä, îí óæå â ïîëíîì ðàçðåøåíèè.
	float3 image_o;
	if (da_upscale.z > 0.5)
	{
		image_o = s_fsr2.Sample(smp_rtlinear, I.Tex0).rgb;
	}
	else
	{
		float3	t_0 = da_fetch_scene(s_base0, I.Tex0);
		float3	t_1 = da_fetch_scene(s_base1, I.Tex1);
		image_o = (t_0+t_1)*.5;
	}
#else
	float3	t_0 	= da_fetch_scene(s_base0, I.Tex0);
	float3	t_1 	= da_fetch_scene(s_base1, I.Tex1);
	float3 	image_o	= (t_0+t_1)*.5;					// add_d2
#endif

	// [DA_PORT] Ðåçêîñòü - íà òîì æå ìåñòå è ïî òåì æå ïðèçíàêàì, ÷òî â postprocess.ps.
	if (da_upscale.x > 0.001 && da_upscale.z < 0.5 && pos_decompression_params2.x < screen_res.x - 0.5)
		image_o = da_sharpen_upscaled(s_base0, I.Tex0, image_o, da_upscale.x);

	if (da_upscale.w > 0.5 && da_upscale.x > 0.001)
		image_o = da_sharpen_output(s_fsr2, I.Tex0, image_o, da_upscale.x, screen_res.zw);

	// Äàëüøå - àâòîðñêàÿ öâåòîêîððåêöèÿ ïî ãðàäèåíòíûì òàáëèöàì, áåç èçìåíåíèé.
	float	grad_i 	= dot		(image_o,(0.3333h).xxx);

	float3 	image0 	= s_grad0.Sample( smp_rtlinear, float2(grad_i,0.5));
	float3 	image1 	= s_grad1.Sample( smp_rtlinear, float2(grad_i,0.5));
	float3	image	= lerp		(image0, image1, c_colormap.y);
			image	= lerp		(image_o, image, c_colormap.x);

	float	gray 	= dot		(image,I.Gray);			// dp3
			image 	= lerp 		(gray,image,I.Gray.w);		// mul/mad

	float4	t_noise	= s_noise.Sample( smp_linear, I.Tex2);
	float3 	noised 	= image*t_noise*2;                     		// mul_2x
			image	= lerp( noised, image, I.Color.w); 	// lrp ?
			image	= (image * I.Color + c_brightness)*2;		// mad

	// [DA_PORT] Öâåòîêîððåêöèÿ ïîëçóíêàìè è ãàììà - ïîñëåäíèìè, êàê â postprocess.ps.
	image *= da_color_grade.rgb;
	if (da_color_grade.w > 0.001)
		image = da_apply_vibrance(image, da_color_grade.w);

	if (da_gamma.w > 0.5)
		image = da_apply_gamma(image);

	// out
	return  float4( max(image, 0.0), 1.0h);				// +mov
}
