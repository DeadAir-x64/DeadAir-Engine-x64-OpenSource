#include "common.h"

// [DA_PORT] Метка самосветящейся геометрии в маске реактивности.
//
// Свечение (лампочка, телевизор, светящаяся палочка в руке) рисуется ПОСЛЕ G-буфера, отдельным
// проходом, и цель у него ровно одна - накопитель освещения: см. phase_accumulator, там стоит
// u_setrt(cmd_list, rt_Accumulator, nullptr, nullptr, rt_MSAADepth). Ни вектора движения, ни
// реактивность эти пиксели не пишут - там остаётся то, что записала непрозрачная геометрия под
// ними и вокруг них. Для апскейлера ореол свечения, вылезающий за силуэт предмета, помечен как
// ФОН: с движением фона и с полным доверием к истории.
//
// Отсюда и берётся пила по кромке свечения и мерцание ламп: каждый кадр джиттер сдвигает выборку
// на доли пикселя, апскейлер тянет для этих пикселей историю по чужому вектору, и яркое пятно
// то попадает в свою историю, то мажет мимо.
//
// Ровно для этого случая маска реактивности и существует - и FSR, и DLSS требуют помечать в ней
// полупрозрачное и композированное поверх кадра. Проход пишет в неё постоянное значение там, где
// трафарет говорит "здесь только что рисовалось свечение".
//
// Значение приходит константой, а не зашито: сила метки - это ручка r__reactive_emissive, и её
// подбирают глазами в игре. Ноль полностью выключает проход в движке, сюда он не доходит.
uniform float4 da_mark; // x = значение метки

// Порядок полей обязан совпадать с da_fullscreen.vs - именно он связывает стадии.
struct vf
{
	float2 tc0   : TEXCOORD0;
	float4 hpos  : SV_Position;
};

float4 main(vf I) : SV_Target
{
	// Ни одной выборки: куда писать, решает трафаретный тест, а не содержимое буферов. Отбор
	// геометрии уже сделан тем проходом, который эти пиксели нарисовал.
	return float4(da_mark.x, 0, 0, 0);
}
