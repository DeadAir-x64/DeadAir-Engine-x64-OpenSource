#include "common.h"
#include "shared\waterconfig.h"
#include "shared\watermove.h"

// [DA_PORT] Векторы движения для воды.
//
// Вода рисуется в прямом проходе, после G-буфера, и потому не пишет ни глубины, ни векторов
// движения. Для апскейлера это означает вот что: на пикселях озера в буфере скоростей лежит вектор
// ДНА — геометрии, которая находится на другой глубине. Перенося кадр, апскейлер берёт историю не
// оттуда, где вода была, и поверхность мигает целиком при каждом повороте камеры.
//
// Маской реактивности это не лечится, и это проверено: вода горит на маске максимумом, DLSS её
// получает, мигание не меняется. Маска говорит «не доверяй истории», а беда в том, что история
// берётся из чужого места.
//
// Поэтому воду рисуем ещё раз, отдельным проходом, прямо в буфер скоростей. Волновая функция здесь
// обязана совпадать с water.vs до последнего знака: считать вектор для поверхности, которая стоит не
// там, где нарисованная, — хуже, чем не считать вовсе.
//
// ⛔ [DA_PORT] ВХОД ОБЪЯВЛЯЕТСЯ ТОЛЬКО ОДИН, И ЭТО НЕ УПРОЩЕНИЕ — ЭТО ЛЕЧЕНИЕ.
//
// Раньше здесь стоял вход, переписанный из water.vs целиком: POSITION, NORMAL, TANGENT, BINORMAL,
// COLOR0, TEXCOORD0. Читался из них ровно один — POSITION; остальные пять компилятор пометил
// «не используется» (маска чтения 0), но из СИГНАТУРЫ шейдера не убрал.
//
// А DirectX 11 сверяет раскладку вершин именно с сигнатурой, а не с тем, что шейдер читает: он
// требует, чтобы раскладка содержала ВСЕ объявленные входы. Водной геометрии же приходит две разных
// раскладки, и ни в одной нет всех шести:
//   POSITION COLOR TEXCOORD                  — нет NORMAL/TANGENT/BINORMAL
//   POSITION NORMAL TANGENT BINORMAL TEXCOORD — нет COLOR
// Обе отвергались с 0x80070057, разметка не создавалась, и весь проход векторов воды не выполнялся
// НИ РАЗУ — при том, что в логе это выглядело как пара безобидных строк на загрузке уровня.
//
// С одним входом раскладка подходит любая: лишние элементы раскладки DirectX разрешает, недостающие
// объявленные — нет.
struct v_vert
{
	float4	P		: POSITION;
};

// [DA_PORT] Имена обязаны быть ровно такими: движок привязывает эти матрицы ПО ИМЕНИ
// (Blender_Recorder_StandartBinding.cpp, r_Constant("m_WVP_old"/"m_VP_nojit")). Переименуешь —
// привязка молча не сработает, и вектор посчитается по единичной матрице.
//
// В common_iostructs.h они объявлены под DA_VELOCITY, который включает запись векторов во ВСЕЙ
// геометрии. Нам нужны только матрицы, поэтому объявляем сами — но лишь тогда, когда общий заголовок
// этого не сделал, иначе получим повторное объявление.
#ifndef DA_VELOCITY
uniform float4x4	m_WVP_old;
uniform float4x4	m_VP_nojit;
#endif

struct vf
{
	float4	hpos_curr	: TEXCOORD0;	// позиция этого кадра, без джиттера
	float4	hpos_old	: TEXCOORD1;	// она же в предыдущем кадре
	float4	hpos		: SV_Position;
};

vf main(v_vert v)
{
	vf o;

	float4 P = watermove(v.P);

	o.hpos      = mul(m_VP,       P);
	o.hpos_curr = mul(m_VP_nojit, P);

	// [DA_PORT] Предыдущее положение берём от ТОЙ ЖЕ точки.
	//
	// Строго говоря, вершины воды колеблются по вертикали (watermove сдвигает их синусом от времени),
	// и честный вектор учитывал бы ещё и это. Но амплитуда там три сантиметра, а времени предыдущего
	// кадра в шейдере нет — пришлось бы заводить его отдельной константой ради доли пикселя. Всё
	// заметное движение воды на экране даёт камера, и вот оно посчитано точно.
	o.hpos_old  = mul(m_WVP_old,  P);

	return o;
}
