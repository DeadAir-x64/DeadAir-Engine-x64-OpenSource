#include "common.h"
#include "da_shader_ids.h"
#include "sload.h"
#include "da_puddles.h"	// [DA_PORT] лужи в дождь

// [DA_PORT] Все ДЕВЯТЬ детальных выборок ландшафта идут через собственный сдвиг мипов
// (r__detail_mipbias, uniform da_detail_bias из sload.h). У ландшафта СВОЙ путь детали -
// четыре альбедо s_dt_*, четыре карты нормалей s_dn_* и общий s_detail - и правка одного
// sload.h его не покрывала: ручка работала на стенах и не работала на земле. Детальные
// нормали дёргают нормаль ландшафта на частоте пикселя; на склоне солнце падает вскользь,
// и при рендере ниже 100% эта рябь мерцает под джиттером. Ноль = как было.
#define	USE_4_DETAIL

#if defined(USE_TDETAIL) && defined(USE_4_DETAIL)
#	define	USE_4_BUMP
#endif

#ifdef USE_4_BUMP
f_deffer 	main	( p_bumped I 	)
#else
f_deffer 	main	( p_flat I 		)
#endif
{
	f_deffer	O;

 	// diffuse
	float4 D		= tbase		(I.tcdh);			// IN:  rgb.a
//	float4 L 	= tex2D		(s_lmap, I.tcdh);
	float4 L 	= s_lmap.Sample( smp_base, I.tcdh);

	float	G	= def_gloss	;

# ifdef	USE_TDETAIL
 # ifdef USE_4_DETAIL
//	float4	mask= tex2D		(s_mask, I.tcdh);
	// [DA_PORT] ДРОЖАНИЕ КООРДИНАТЫ МАСКИ (r__mask_jitter). Ноль — прежняя выборка.
	//
	// Разбор — у ручки в движке. Коротко: вдали видна не граница слоёв, а сама маска — текстура
	// низкого разрешения, чей плавный градиент растянут на десятки метров и читается полосой.
	// Сдвигая точку выборки шумом, мы превращаем гладкую дугу в языки.
	//
	// Шум берём из детальной текстуры на КРУПНОМ шаге (da_macro_var.y — та же величина, что у
	// макро-вариации). Крупный масштаб принципиален: мелкий мип бы усреднил, и вдали дрожание
	// исчезло бы ровно там, где оно и нужно.
	float2	mask_uv = I.tcdh;
	[branch] if (da_macro_var2.w > 0.0001f)
	{
		const float2 n2 = s_dt_r.Sample( smp_base, I.tcdbump * da_macro_var.y).rg - 0.5f;
		mask_uv += n2 * da_macro_var2.w;
	}
	float4	mask= s_mask.Sample ( smp_base, mask_uv);
	float 	mag	= dot 		(mask,1);
			mask= mask/mag	;

//	float3	d_R	= tex2D		(s_dt_r, I.tcdbump)*mask.r;
//	float3	d_G	= tex2D		(s_dt_g, I.tcdbump)*mask.g;
//	float3	d_B	= tex2D		(s_dt_b, I.tcdbump)*mask.b;
//	float3	d_A	= tex2D		(s_dt_a, I.tcdbump)*mask.a;
	// [DA_PORT] Сначала ЧИСТЫЕ цвета слоёв — вес применяется ниже, после выбора способа смешивания.
	float3	c_R	= s_dt_r.SampleBias( smp_base, I.tcdbump, da_detail_bias.x);
	float3	c_G	= s_dt_g.SampleBias( smp_base, I.tcdbump, da_detail_bias.x);
	float3	c_B	= s_dt_b.SampleBias( smp_base, I.tcdbump, da_detail_bias.x);
	float3	c_A	= s_dt_a.SampleBias( smp_base, I.tcdbump, da_detail_bias.x);

	// [DA_PORT] СМЕШИВАНИЕ ПО ВЫСОТЕ (r__terrain_blend). Ноль — в точности прежнее, линейное.
	//
	// Разбор — у ручки в движке. Коротко: линейное смешивание даёт на стыке слоёв мыльную полосу или
	// ровную линию. Здесь побеждает слой, у которого в этой точке ВЫШЕ рельеф, и край выходит
	// зубчатым — трава проступает сквозь грунт, а не сходит на нет полосой.
	//
	// За высоту берётся яркость текстуры: карт высоты у слоёв нет, а это стандартная замена.
	// Вес умножается, а не складывается, чтобы отсутствующий слой (вес 0) не мог победить яркостью.
	// Порог 0.2 задаёт ширину перехода: меньше — резче, больше — ближе к линейному.
	float4	w	= mask;
	[branch] if (da_macro_var2.z > 0.001f)
	{
		const float3 LUM = float3(0.299f, 0.587f, 0.114f);
		float4 wh = mask * (1.0f + float4(dot(c_R,LUM), dot(c_G,LUM), dot(c_B,LUM), dot(c_A,LUM)));
		float  ma = max(max(wh.x, wh.y), max(wh.z, wh.w)) - 0.2f;
		float4 b  = max(wh - ma, 0.0f);
		b /= max(dot(b, 1.0f), 1e-5f);
		w = lerp(mask, b, saturate(da_macro_var2.z));
	}

	float3	d_R	= c_R*w.r;
	float3	d_G	= c_G*w.g;
	float3	d_B	= c_B*w.b;
	float3	d_A	= c_A*w.a;
	float3	dt	= d_R+d_G+d_B+d_A;

	// [DA_PORT] КРУПНАЯ ДЕТАЛЬ ДАЛИ (r__macro_detail). Ноль — прежнее поведение.
	//
	// Разбор — у ручки в движке. Коротко: вдали пиксель накрывает сотни текселей детали, и она
	// усредняется в один тон. Читая ТУ ЖЕ текстуру с шагом повторения в шестнадцать раз крупнее, мы
	// заставляем пиксель накрывать во столько же раз меньше текселей — и узор доживает до горизонта.
	//
	// Смешиваем ТЕМИ ЖЕ весами w, что и вблизи: иначе у дали было бы другое покрытие, чем под ногами,
	// и переход читался бы сменой материала, а не сменой масштаба.
	[branch] if (da_detail_bias.w > 0.001f)
	{
		const float d_cd = length(I.position.xyz);
		const float f_cd = saturate((d_cd - da_macro_var.z) / max(da_macro_var.w - da_macro_var.z, 1.0f));
		[branch] if (f_cd > 0.001f)
		{
			const float2 uv_cd = I.tcdbump * da_macro_var.y;
			const float3 k_R = s_dt_r.Sample( smp_base, uv_cd);
			const float3 k_G = s_dt_g.Sample( smp_base, uv_cd);
			const float3 k_B = s_dt_b.Sample( smp_base, uv_cd);
			const float3 k_A = s_dt_a.Sample( smp_base, uv_cd);
			const float3 dt_coarse = k_R*w.r + k_G*w.g + k_B*w.b + k_A*w.a;
			dt = lerp(dt, dt_coarse, saturate(da_detail_bias.w * f_cd));
		}
	}
		D.rgb	= 2*D.rgb*dt	 ;

  # ifdef USE_4_BUMP

// 	 float4	n_Rt = tex2D	(s_dn_r, I.tcdbump).wzyx;
//	 float4	n_Gt = tex2D	(s_dn_g, I.tcdbump).wzyx;
//	 float4	n_Bt = tex2D	(s_dn_b, I.tcdbump).wzyx;
//	 float4	n_At = tex2D	(s_dn_a, I.tcdbump).wzyx;
 	 float4	n_Rt = s_dn_r.SampleBias( smp_linear, I.tcdbump, da_detail_bias.x).wzyx;
	 float4	n_Gt = s_dn_g.SampleBias( smp_linear, I.tcdbump, da_detail_bias.x).wzyx;
	 float4	n_Bt = s_dn_b.SampleBias( smp_linear, I.tcdbump, da_detail_bias.x).wzyx;
	 float4	n_At = s_dn_a.SampleBias( smp_linear, I.tcdbump, da_detail_bias.x).wzyx;
	 
 	 // [DA_PORT] ТЕ ЖЕ веса, что у альбедо (w вместо mask). Иначе цвет переходил бы по одной границе,
	 // а рельеф по другой, и стык стал бы виден вдвойне.
	 float3	n_R = (n_Rt-0.5)*w.r; float g_R=n_Rt.w*w.r;
	 float3	n_G = (n_Gt-0.5)*w.g; float g_G=n_Gt.w*w.g;
	 float3	n_B = (n_Bt-0.5)*w.b; float g_B=n_Bt.w*w.b;
	 float3	n_A = (n_At-0.5)*w.a; float g_A=n_At.w*w.a;

	 float3	mix		= 	n_R+n_G+n_B+n_A;
			mix.z	*=	0.5;		//. make bump twice as contrast (fake, remove me if possible)
	// [DA_PORT] ЗАТУХАНИЕ ДЕТАЛЬНОЙ НОРМАЛИ С РАССТОЯНИЕМ (r__detail_normal_fade, метры).
	//
	// Разбор - у ручки в движке. Коротко: детальное альбедо рядом гаснет с дальностью, а нормаль
	// не гасла никогда, и за Найквистом её рисунок превращался в рябь на частоте пикселя.
	//
	// Гасятся ТОЛЬКО xy - составляющие в плоскости поверхности. z трогать нельзя: именно он несёт
	// Â«нормаль смотрит наружуÂ», и обнулив его целиком мы получили бы нулевой вектор, а normalize
	// от нуля - это NaN и чёрные пятна. Обнуление одних xy оставляет ровно вершинную нормаль, то
	// есть ту самую гладкую поверхность, к которой деталь и обязана сходиться вдали.
	[branch] if (da_detail_bias.z > 0.5f)
	{
		const float d_n  = length(I.position.xyz);
		const float half_n = da_detail_bias.z * 0.5f;
		mix.xy *= 1.0f - saturate((d_n - half_n) / max(half_n, 0.001f));
	}


	// [DA_PORT] КРУПНЫЙ РЕЛЬЕФ ДАЛИ (r__macro_relief). Ноль — прежнее поведение.
	//
	// Разбор — у ручки в движке. Коротко: цветом даль уже покрашена в оттенок травы, но одного цвета
	// мало — выходит крашеная плоскость. Поверхность вдали опознаётся светотенью на неровностях,
	// поэтому подмешиваем крупную детальную нормаль: её период мип не усредняет, и склоны начинают
	// по-разному ловить солнце.
	//
	// Подмешиваем ТОЛЬКО xy — наклон в плоскости поверхности. z несёт «нормаль смотрит наружу», и
	// трогать его нельзя: обнулив, получим нулевой вектор, а normalize от нуля это NaN.
	//
	// Знаменатель порога тот же, что у цвета, чтобы обе подмешки нарастали согласованно и не давали
	// двух разных границ в кадре.
	[branch] if (da_macro_var2.y > 0.001f && da_macro_var.x > 0.001f)
	{
		const float d_mr = length(I.position.xyz);
		const float f_mr = saturate((d_mr - da_macro_var.z) / max(da_macro_var.w - da_macro_var.z, 1.0f));
		[branch] if (f_mr > 0.001f)
		{
			const float2 nr = s_dn_r.Sample(smp_linear, I.tcdbump * da_macro_var.y).wz - 0.5f;
			mix.xy += nr * da_macro_var2.y * f_mr;
		}
	}

	 float3	N		= 	mul     	(float3x3(I.M1, I.M2, I.M3), mix.xyz);

	 	 	G 		= 	g_R+g_G+g_B+g_A;
//			G 	= 0			;
//			G 	= mix.w		;		// gloss
  # else
	float3	N 	= I.N.xyz	;
  # endif

 # else
//	D.rgb	= 2*D.rgb*tex2D	(s_detail, I.tcdbump).rgb;
	D.rgb	= 2*D.rgb*s_detail.SampleBias( smp_base, I.tcdbump, da_detail_bias.x).rgb;
 # endif
# else
	float3	N 	= I.N.xyz	;
# endif

	// [DA_PORT] Лужи и мокрая земля. Стоит здесь, а не раньше: к этому месту собраны и нормаль после
	// детальных карт, и глянец, и цвет — то есть ровно те три величины, которые вода и меняет.
	//
	// ⚠️ Функция считает ТОЛЬКО маску и нормаль. Цвет и глянец меняются здесь же, обычными строками в
	// том же теле шейдера, — и это не стилистика.
	//
	// История: сначала цвет отдавался через `inout`, потом через поле возвращаемой структуры, и оба
	// раза он НЕ доезжал до кадра. Проба с абсолютным чёрным цветом внутри функции подтвердила это
	// однозначно: маска живая, константы живые, нормаль применяется — а цвет нет. В кадре оставался
	// один контур лужи, «разметка». Что именно теряется по дороге, я так и не назвал; вместо ещё
	// одной догадки убрана сама возможность потери — маска это одно число, и применяется оно там же,
	// где живёт D.
	// [DA_PORT] Лужи в G-буфере: нормаль, глянец, цвет. Возврат к варианту, утверждённому в игре.
	//
	// Наложение после освещения (da_puddle_refl.ps) даёт математически чистую границу, но вода в нём
	// теряет объём: плоская нормаль в G-буфере — это то, что заставляет отложенное освещение считать
	// поверхность ровной, и никакое наложение поверх готового кадра этого не заменяет. Проверено
	// обеими версиями подряд; выбран этот, с ценой в виде тонкой каймы по краю.
	//
	// Наложение осталось, но занимается только отражением мира — тем, чего G-буфер сделать не может.
	// Признак «сюда попадает дождь». Где уровень скомпилирован со статическим солнцем, берём ДОСТУП
	// СОЛНЦА из лайтмапы (L.w): под крышей он ноль по построению. Где его нет — остаётся альфа базовой
	// текстуры, как раньше. Именно на ней лужи и заводились в помещениях: она к небу отношения не имеет.
#ifdef USE_R2_STATIC_SUN
	const float da_sky_src = L.w;
#else
	const float da_sky_src = D.w;
#endif
	da_puddle_result P = da_puddles(I.position.xyz, da_sky_src, N);
	D.w = P.hemi;

	// [DA_PORT] Выключатель G-буферной половины луж (r__puddles_gbuf).
	//
	// Обводка родится ЗДЕСЬ и только здесь: у края маски встречаются бугристая земля и плоская вода,
	// и как их ни переключай — резко или плавно — на стыке остаётся шов. Со швом боролись пять
	// заходов в лоб и не победили; тёмную кайму завели, чтобы он в ней тонул, но при выключенном
	// потемнении воды кайма сама стала самой заметной линией в кадре.
	//
	// Проход наложения (da_puddle_refl.ps) свободен от этого по построению: он смешивается с кадром
	// ПО АЛЬФЕ, а альфа границ не подчёркивает. У него своя нормаль воды, своя рябь и свой солнечный
	// блик — то есть он самодостаточен. Цена отказа от G-буфера записана там же: плоская нормаль
	// давала объём и отклик на лампы и костры, чего наложение поверх кадра не даёт.
	//
	// Ручка нужна, чтобы сравнить оба вида в игре, а не рассуждать о них.
	[branch] if (da_puddle_look2.w > 0.5f)
	{
		N = P.N;

		[branch] if (P.dbg_paint)
		{
			D.rgb = P.dbg_color;
			G = 0.0f;
		}
		else
		{
			// Общая мокрота: шире луж и слабее их.
			D.rgb *= lerp(1.0f, 0.88f, P.damp);
			G = max(G, P.damp * da_puddle_look.z);

			// Тёмная кайма промокшего грунта вокруг воды.
			D.rgb *= lerp(1.0f, saturate(da_puddle_look2.z), P.rim);

			// Сама вода: темнее и глянцевее. max(), а не замена — вода не может быть матовее того, на
			// чём стоит.
			D.rgb *= lerp(1.0f, saturate(da_puddle_look.y), P.mask);
			// [DA_PORT] Глянец — по МЯГКОЙ маске, а не по ступени.
			//
			// Ступенью переключается только нормаль: усреднённая между бугристой землёй и плоской водой
			// она не смотрит никуда и даёт тёмный шов. У глянца этой беды нет — он скаляр, промежуточное
			// значение у него осмысленно.
			//
			// А ступенью он давал СВОЮ линию, и видно её было там, где сильный свет: у костра с одной
			// стороны пикселя полный блик, с другой ноль. В пасмурной тени это незаметно, поэтому artefact
			// долго списывался то на кайму, то на отражения.
			G = lerp(G, max(G, saturate(da_puddle_look.x)), P.mask);
		}
	}
	else
	{
		// Мокрота остаётся: она шире луж, считается без порога по шуму и краёв не даёт.
		D.rgb *= lerp(1.0f, 0.88f, P.damp);
		G = max(G, P.damp * da_puddle_look.z);
	}

	// [DA_PORT] ПРИБОР (r__motion_vectors 7): насколько нормаль меняется ПОПЕРЁК ОДНОГО ПИКСЕЛЯ.
	//
	// Прямой ответ на вопрос, ради которого он делался. Мерцание под дрожанием выборки возникает
	// тогда, и только тогда, когда величина заметно меняется на масштабе меньше пикселя: сдвиг
	// выборки на долю пикселя даёт другую нормаль, другое N*L и другой блик. Экранные производные
	// измеряют ровно это и прямо здесь, где нормаль уже собрана.
	//
	// Прибор живёт ВНУТРИ шейдера земли намеренно. Показ буфера нормалей в постобработке дал ровный
	// серый: цель к тому моменту уже занята под другое, и вид молча читал ноль. Здесь такого
	// разночтения нет по построению - величина берётся там же, где рождается.
	//
	// Чёрное - нормаль гладкая, мерцать нечему. Красное - меняется, синее - меняется СИЛЬНО.
	[branch] if (da_detail_bias.y > 6.5f && da_detail_bias.y < 7.5f)
	{
		const float3 nn = normalize(N);
		const float  v  = length(ddx(nn)) + length(ddy(nn));
		D.rgb = float3(saturate(v * 8.0f), 0.0f, saturate(v * 40.0f - 4.0f));
		G = 0.0f;
	}

	// [DA_PORT] РАЗДЕЛЯЮЩИЕ РЕЖИМЫ. Прибор 7 менял СРАЗУ ДВЕ величины - альбедо и глянец, - и когда
	// при нём мерцание ослабло, вопрос Â«которая из двухÂ» остался без ответа. Эти два режима меняют
	// строго по одной, поэтому ответ у них однозначный.
	//
	// 8 - глянец в ноль, альбедо нетронуто. Гаснет блик, остаётся рассеянный свет.
	// 9 - альбедо ровное, глянец нетронут. Уходит рисунок цвета, остаётся блик.
	[branch] if (da_detail_bias.y > 7.5f && da_detail_bias.y < 8.5f)
		G = 0.0f;
	[branch] if (da_detail_bias.y > 8.5f)
		D.rgb = 0.35f;



	// [DA_PORT] ⚠️ ТОЛЬКО в варианте с детальными слоями: I.tcdbump есть лишь там. Без этого
	// условия шейдер не собирается в сборке без детали, а движок такой отказ гасит подстановкой
	// заглушки — то есть поломка была бы молчаливой. Поймано офлайн-проверкой check_shaders.
#ifdef USE_4_BUMP
	// [DA_PORT] КРУПНЫЙ СЛОЙ ВАРИАЦИИ (r__macro_var). Ноль — в точности прежнее поведение.
	//
	// Разбор — у ручки в движке. Коротко: вдали деталь усредняется мипами в один цвет, и земля
	// становится ровной заливкой. Берём ту же текстуру ещё раз, но с шагом повторения в десяток раз
	// крупнее — такой период мип не усредняет, и крупные пятна доживают до горизонта.
	//
	// Почему одна выборка, а не все четыре слоя: нужна не достоверная деталь, а правдоподобная
	// крупная неоднородность. Четыре выборки стоили бы вчетверо, а на глаз добавили бы немного —
	// разница между слоями на таком масштабе всё равно теряется.
	//
	// Модулируем ЯРКОСТЬЮ вокруг единицы, а не подмешиваем цвет: тон земли задан базовой текстурой и
	// маской, и вмешательство в него дало бы уплывающий оттенок на стыке ближнего и дальнего плана.
	[branch] if (da_macro_var.x > 0.001f)
	{
		const float d_mv = length(I.position.xyz);
		const float f_mv = saturate((d_mv - da_macro_var.z) / max(da_macro_var.w - da_macro_var.z, 1.0f));
		[branch] if (f_mv > 0.001f)
		{
			const float3 mv = s_dt_r.Sample(smp_base, I.tcdbump * da_macro_var.y).rgb;
			const float  lum = dot(mv, float3(0.299f, 0.587f, 0.114f));
			D.rgb *= 1.0f + (lum - 0.5f) * 2.0f * da_macro_var.x * f_mv;

			// [DA_PORT] «Фальшивая трава» (r__macro_tint): вдали тянем ОТТЕНОК земли к оттенку детали.
			//
			// Настоящая трава заканчивается на r__detail_radius, и дальше остаётся голая базовая
			// текстура уровня - обычно бурая. Отсюда и ощущение обрыва. Красим землю в цвет той травы,
			// что на ней растёт: он уже есть в крупной выборке выше, новых чтений не нужно.
			//
			// ⚠️ Переносим ТОЛЬКО оттенок. Цель приводится к ЯРКОСТИ земли, иначе подмена перебила бы
			// освещение: склон в тени стал бы той же яркости, что освещённый, и рельеф сплющился бы.
			// Малая добавка в знаменателе - защита от чёрного пикселя, на нём деление дало бы бесконечность.
			[branch] if (da_macro_var2.x > 0.001f)
			{
				// [DA_PORT] Цвет берём из dt - смеси ВСЕХ ЧЕТЫРЁХ слоёв по маске, а не из одного
				// s_dt_r, как было сперва. Разница принципиальная: s_dt_r - это КРАСНЫЙ слой, и там,
				// где земля покрыта другим, подмешивался чужой цвет. Проба с силой 1 показала это
				// прямо: даль стала БУРОЙ вместо зелёной - красный слой в том месте оказался грунтом.
				//
				// dt уже посчитана выше и ничего не стоит. Вдали она сминеферивается в средний цвет
				// правильной смеси - то есть ровно в цвет того покрытия, что здесь растёт.
				const float lum_d = dot(D.rgb, float3(0.299f, 0.587f, 0.114f));
				const float lum_t = dot(dt, float3(0.299f, 0.587f, 0.114f));
				const float3 tinted = dt * (lum_d / max(lum_t, 0.001f));
				D.rgb = lerp(D.rgb, tinted, saturate(da_macro_var2.x * f_mv));
			}
		}
	}
#endif
	// hemi, sun, material
	float 	ms	= xmaterial	;
# ifdef USE_R2_STATIC_SUN
		 	ms 	= L.w		;
# endif

  // 2. Standart output
  float4     Ne = float4	(normalize(N), 									D.w*H_TERR			);
  O				= pack_gbuffer( 
								Ne,	// hemi
								float4 	(I.position.xyz + Ne.xyz*def_virtualh/2.h, 	ms			),	//
								sat(float4(D.x,D.y,D.z,G*0.4),0.8));	// OUT: rgb.gloss

  	// [DA_PORT] Motion vector / debug stamp.
#ifdef DA_VELOCITY
#ifdef DA_DEBUG_SHADER_IDS
	O.velocity = DA_ID_IMPL;
#else
	O.velocity = I.hpos_curr.xy / I.hpos_curr.w - I.hpos_old.xy / I.hpos_old.w;
	// [DA_PORT] Moving pixels distrust their history - see da_motion_reactive.
	O.reactive = max( O.reactive, da_motion_reactive(O.velocity) );
#endif
#endif

return O;
}
