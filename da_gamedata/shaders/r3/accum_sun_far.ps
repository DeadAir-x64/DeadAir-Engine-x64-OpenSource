#include "common.h"
#include "lmodel.h"

#ifdef USE_MINMAX_SM
#define SM_MINMAX
#endif

// [DA_PORT] ПУТЬ МЯГКИХ ТЕНЕЙ ОТКЛЮЧЁН. Было: #if SUN_QUALITY>2 -> ULTRA_SHADOWS_ON.
//
// При r2_sun_quality st_opt_extreme (SUN_QUALITY 4) shadow() уходил в shadow_extreme_quality -
// стоковый фильтр мягких теней с поиском блокера. На нём средний и дальний каскады давали НОЛЬ
// света, а ближний работал: у него задан SM_MINMAX, и в этот фильтр он в основном не заходит -
// его перехватывает быстрый выход cheap_reject. Отсюда ступень на стыке, едущая с камерой.
//
// Доказано прибором r__dbg_sun_cascades (near=R, middle=G, far=B): красный вблизи есть, зелёного
// и синего нет вовсе. Подтверждено тремя опытами: da_sun_only 1 (только ближний) ступень убирает;
// r2_sun_quality st_opt_high убирает; r2_sun_near / r2_sun_far / r2_sun_depth_far_bias /
// r__sun_shadow_fade не влияют вообще - дело не в геометрии каскадов.
//
// Код фильтра - СТОКОВЫЙ, наши правки его не касались: сверено с распакованными из архивов
// шейдерами, все различия только в sample_hw_pcf / da_pcf_footprint / shadow_hw.
//
// Проверенная и НЕ помогшая гипотеза: нормировка modify_light применялась только под SM_MINMAX,
// то есть только к ближнему каскаду. Распространение её на все три картину не исправило -
// причина глубже, внутри самого PCSS.
//
// Без этого определения все три каскада идут в shadow_hw - тот же путь, что при st_opt_high, и
// именно в нём живут наши правки: масштаб ядра по следу пикселя и поворот выборки.
//
// ВНИМАНИЕ. Возвращать обратно только после замера ВНУТРИ shadow_extreme_quality - выводом самого
// значения тени и доли перекрытия цветом. Перебор ручек этот дефект не находит: проверяли, четыре
// подряд промолчали.
//
//#if SUN_QUALITY>2
//#define ULTRA_SHADOWS_ON
//#endif //	SUN_QUALITY>2

#ifdef ULTRA_SHADOWS_ON
#define USE_ULTRA_SHADOWS
#endif

#include "shadow.h"
uniform float3	view_shadow_proj;	// [DA_PORT] Р±РѕР»СЊС€Рµ РЅРµ РёСЃРїРѕР»СЊР·СѓРµС‚СЃСЏ (СЃРј. Р·Р°С‚СѓС…Р°РЅРёРµ РЅРёР¶Рµ)
uniform float4	da_sun_far_fade;	// [DA_PORT] x = РЅР°С‡Р°Р»Рѕ Р·Р°С‚СѓС…Р°РЅРёСЏ, y = РїРѕР»РЅС‹Р№ СЃРІРµС‚ (РјРµС‚СЂС‹ РѕС‚ РєР°РјРµСЂС‹)


#ifdef USE_SUNFILTER
#ifdef MSAA_OPTIMIZATION
float4 main ( v2p_volume I, uint iSample : SV_SAMPLEINDEX  ) : SV_Target
#else
float4 main ( v2p_volume I  ) : SV_Target
#endif
{
	//float4 _P = tex2D( s_position, tc );

	gbuffer_data gbd = gbuffer_load_data( GLD_P(I.tc, I.hpos, ISAMPLE) );

#ifdef	GBUFFER_OPTIMIZATION
	//	Emulate virtual offset
	gbd.P += gbd.N*0.015f;
#endif	//	GBUFFER_OPTIMIZATION

	float4 _P = float4( gbd.P, 1.f);

	float4 PS = mul( m_shadow,  _P );

	float s	= shadowtest_sun( PS, I.tcJ ) * sunmask( _P );

	return s;
}
#else
#ifdef MSAA_OPTIMIZATION
float4 main ( v2p_volume I,  uint iSample : SV_SAMPLEINDEX ) : SV_Target
#else
float4 main ( v2p_volume I ) : SV_Target
#endif
{
	//float4 	_P	= tex2D( s_position, tc );
	//float4	_N	= tex2D( s_normal, tc );

	gbuffer_data gbd = gbuffer_load_data( GLD_P(I.tc.xy/I.tc.w, I.hpos, ISAMPLE) );

#ifdef	GBUFFER_OPTIMIZATION
	//	Emulate virtual offset
	gbd.P += gbd.N*0.015f;
#endif	//	GBUFFER_OPTIMIZATION

	float4 _P = float4( gbd.P, gbd.mtl );
	float4  _N = float4( gbd.N, gbd.hemi );

	// ----- light-model
	float	m	= xmaterial;
# ifndef USE_R2_STATIC_SUN
			m 	= _P.w;
# endif
	float4	light	= plight_infinity ( m, _P, _N, Ldynamic_dir );

	// ----- shadow
  	float4 	P4 	= float4( _P.x, _P.y, _P.z, 1.f);
	float4 	PS	= mul( m_shadow, P4 );
	float 	s 	= sunmask( P4 );
	#if defined	(USE_SJITTER) || SUN_QUALITY==2 // Hight quality
	  		s 	*= shadow_high(PS); //shadowtest_sun( PS, float4(0,0,0,0) );
	#else
#ifdef SM_MINMAX
		#ifdef USE_SJITTER
	  		s 	*= shadow_dx10_1( PS, I.tcJ, I.hpos.xy );
		#else
			s *= shadow( PS );
		#endif
#else
			s *= shadow( PS );
#endif
	#endif

	// Far edge fading code вЂ” Р·Р°С‚СѓС…Р°РЅРёРµ РґР°Р»СЊРЅРµР№ С‚РµРЅРё РїРѕ Р РђРЎРЎРўРћРЇРќРР® РѕС‚ РєР°РјРµСЂС‹.
	//
	// РСЃС‚РѕСЂРёСЏ: СЃРЅР°С‡Р°Р»Р° С‚СѓС‚ Р±С‹Р» РјРЅРѕР¶РёС‚РµР»СЊ `step( -dot( tc_f, view_shadow_proj.xy ), 0 )` вЂ” РіР°СЃРёР» Р»РёС€СЊ
	// РїРѕР»РѕРІРёРЅСѓ РєР°СЂС‚С‹ РїРѕ РЅР°РїСЂР°РІР»РµРЅРёСЋ РІР·РіР»СЏРґР°, Р»РёРЅРёСЏ СЂР°Р·РґРµР»Р° РµС…Р°Р»Р° РІР»РµРІРѕ/РІРїСЂР°РІРѕ РїСЂРё РїРѕРІРѕСЂРѕС‚Рµ (В«РєР»РёРЅВ»).
	// РЎРёРјРјРµС‚СЂРёС‡РЅРѕРµ Р·Р°С‚СѓС…Р°РЅРёРµ РїРѕ РєСЂР°СЋ РєР°СЂС‚С‹ СѓР±СЂР°Р»Рѕ Р»РµРІРѕ/РїСЂР°РІРѕ, РЅРѕ РѕСЃС‚Р°Р»РѕСЃСЊ РІРµСЂС…/РІРЅРёР·: СЃР°РјР° РґР°Р»СЊРЅСЏСЏ
	// С‚РµРЅРµРІР°СЏ РєР°СЂС‚Р° РїРѕРґРѕРіРЅР°РЅР° РїРѕРґ РїРёСЂР°РјРёРґСѓ РєР°РјРµСЂС‹, РµС‘ РљР РћРњРљРђ РґРІРёРіР°РµС‚СЃСЏ РїСЂРё Р»СЋР±РѕРј РїРѕРІРѕСЂРѕС‚Рµ, Рё Р»СЋР±РѕРµ
	// Р·Р°С‚СѓС…Р°РЅРёРµ РїРѕ РєСЂР°СЋ РєР°СЂС‚С‹ РµРґРµС‚ СЃРѕ РІР·РіР»СЏРґРѕРј.
	//
	// РРЅРґСѓСЃС‚СЂРёР°Р»СЊРЅС‹Р№ СЃС‚Р°РЅРґР°СЂС‚ (UE В«Dynamic Shadow DistanceВ», Unity/URP В«max distance fadeВ», Catlike
	// Coding `saturate((1 - d/maxDist)/fade)`): РіР°СЃРёС‚СЊ С‚РµРЅСЊ РІ СЃРІРµС‚ РїРѕ Р РђРЎРЎРўРћРЇРќРР® РѕС‚ РєР°РјРµСЂС‹. Р Р°СЃСЃС‚РѕСЏРЅРёРµ
	// РЅРµ Р·Р°РІРёСЃРёС‚ РѕС‚ РїРѕРІРѕСЂРѕС‚Р° вЂ” РЅРё РєР»РёРЅР°, РЅРё РїРѕР»РѕСЃС‹. РўРµРЅСЊ СѓС…РѕРґРёС‚ РІ СЃРІРµС‚ РЅР° РїРѕРґС…РѕРґРµ Рє РґР°Р»СЊРЅРµР№ РґРёСЃС‚Р°РЅС†РёРё
	// Р”Рћ С‚РѕРіРѕ, РєР°Рє РїРёРєСЃРµР»СЊ РґРѕСЃС‚Р°РЅРµС‚ РґРѕ РґРІРёР¶СѓС‰РµР№СЃСЏ РєСЂРѕРјРєРё РєР°СЂС‚С‹. _P вЂ” РІ РІРёРґРѕРІРѕРј РїСЂРѕСЃС‚СЂР°РЅСЃС‚РІРµ (РєР°РјРµСЂР° РІ
	// РЅСѓР»Рµ), РїРѕСЌС‚РѕРјСѓ length(_P.xyz) = СЂР°СЃСЃС‚РѕСЏРЅРёРµ РґРѕ РєР°РјРµСЂС‹. Р”РёСЃС‚Р°РЅС†РёРё вЂ” СЂСѓС‡РєР° r__sun_shadow_fade.
	float 	cam_dist = length( _P.xyz );
	float 	d_end   = da_sun_far_fade.y;          // РїРѕР»РЅС‹Р№ СЃРІРµС‚ (СЂСѓС‡РєР° r__sun_shadow_fade)
	float 	d_start = d_end * 0.35f;              // Р·Р°С‚СѓС…Р°РЅРёРµ РЅР°С‡РёРЅР°РµС‚СЃСЏ РЎРР›Р¬РќРћ Р·Р°СЂР°РЅРµРµ вЂ” РїР»Р°РІРЅС‹Р№ СЃРїР°Рґ, Р° РЅРµ СЂРµР·РєРѕРµ РєРѕР»СЊС†Рѕ
	float 	fade = saturate( (cam_dist - d_start) / max( d_end - d_start, 1e-3f ) );
	s += (1.f - s) * fade;
	//\ Far edge fading code

	return 		blend( Ldynamic_color * light * s/*float4( 1.f, 0.2f, 0.2f, 1.f)*/, I.tc );
}
#endif