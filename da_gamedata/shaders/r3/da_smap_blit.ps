#include "common.h"

// [DA_PORT] Перенос кэшированной статики лампы в рабочий теневой атлас.
//
// ЗАЧЕМ. Кэш теней ламп держит статику в отдельном атласе со СВОЕЙ, постоянной раскладкой: лампа
// получает место при первом кэшировании и держит его, пока жива. Рабочий атлас перепаковывается
// каждый кадр и вдобавок делится на несколько пачек. Раскладки поэтому не совпадают
// принципиально — и перенос обязан быть полампово. Так же устроено в Unity HDRP: «блит из
// кэшированного атласа в динамический».
//
// ⛔ ПОЧЕМУ НЕ КОПИРОВАНИЕМ РЕСУРСА. В DX11 прямоугольник глубины копировать нельзя: при
// D3D11_BIND_DEPTH_STENCIL субресурс копируется целиком. Значит перенос — это отрисовка, а глубина
// пишется из пиксельного шейдера в SV_Depth.
//
// ⚠️ ПОЧЕМУ ПО ТЕКСЕЛЯМ, А НЕ ПО UV. Через координаты текстуры пришлось бы угадывать ориентацию
// (у полноэкранных проходов движка строка 0 внизу) и следить за фильтрацией — а ошибка в любом из
// двух даёт зеркальную или размазанную тень БЕЗ единого сообщения. Load берёт ровно тот тексель,
// который назван, и обе беды исчезают: адрес источника — это адрес приёмника плюс постоянный сдвиг
// между местом лампы в двух атласах.
uniform float4 da_smap_blit_ofs; // xy = место в атласе статики минус место в рабочем

// Объявление обязано быть И здесь, и в da_smap_blit.s: скрипт связывает имя с целью отрисовки,
// а HLSL без объявления просто не соберётся. Проверено офлайн-сборкой — она это и поймала.
Texture2D s_dastatic;

struct da_blit_out
{
    float Depth : SV_Depth;
};

da_blit_out main(float2 tc0 : TEXCOORD0, float4 hpos : SV_Position)
{
    da_blit_out res;

    // hpos.xy — центр пикселя В КООРДИНАТАХ ЦЕЛИ, то есть уже нужный нам адрес приёмника.
    const int2 dst = int2(hpos.xy);
    const int2 src = dst + int2(da_smap_blit_ofs.xy);

    res.Depth = s_dastatic.Load(int3(src, 0)).x;
    return res;
}
