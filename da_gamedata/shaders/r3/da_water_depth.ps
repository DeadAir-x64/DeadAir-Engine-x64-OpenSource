#include "common.h"

// [DA_PORT] Пиксельная половина глубины воды - разбор в da_water_depth.s.
//
// Вершинную часть берём у векторов воды один в один, включая волновую функцию: иначе глубина
// считалась бы для поверхности, стоящей не там, где нарисованная.
//
// Глубину в пространстве глаза брать неоткуда специально: у обычной перспективной матрицы
// clip.w И ЕСТЬ эта глубина. Джиттер сдвигает только x и y, поэтому на w он не влияет, и
// значение годится независимо от того, дрожит проекция или нет.
struct vf
{
	float4	hpos_curr	: TEXCOORD0;
	float4	hpos_old	: TEXCOORD1;
	float4	hpos		: SV_Position;
};

float4 main(vf I) : SV_Target
{
	// Пишется ТОЛЬКО синий канал - маска записи выставлена в phase_water_depth. Остальные три
	// канала G-буфера позиций (x, y и упаковка материала) обязаны остаться от дна: их читает не
	// темпоралка, а свет и постобработка.
	return float4(0.0, 0.0, I.hpos_curr.w, 0.0);
}
