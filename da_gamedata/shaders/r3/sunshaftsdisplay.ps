#include "common.h"
#include "shadow.h"
// [DA_PORT] Radi sky_s0/sky_s1 i env_color: cvet luchei beretsya iz neba u gorizonta.
#include "hmodel.h"
#include "MrProperCommon.h" // [FX to mrmnwar] Cheking includes, please

float4 blendSoftLight(float4 a, float4 b)
{
	float4 c = 2 * a * b + a * a * (1 - 2 * b);
	float4 d = sqrt(a) * (2 * b - 1) + 2 * a * (1 - b);
	
	return ( b < 0.5 )? c : d;
}

float4	sun_shafts_intensity;

// [DA_PORT] x = доля цвета неба в цвете лучей (r__shafts_sky). Разбор — ниже, у применения.
uniform float4 da_shafts;

//////////////////////////////////////////////////////////////////////////////////////////
//
float4		main		(	AntiAliasingStruct	INStruct	)		:		SV_Target
{
	
#ifdef USE_SSHAFTS
	
	float4 outColor;
	
	float4 cScreen = sScene.Sample(smp_nofilter,INStruct.texCoord0.xy);
	float4 cSunShafts = sSunShafts.Sample(smp_nofilter,INStruct.texCoord0.xy);

	
	float fShaftsMask=saturate(1.00001-cSunShafts.w)*SSParamsDISPLAY.y*2;

	float	max_density = sun_shafts_intensity;
	
	//normalize suncolor
	float4 sunColor = float4(1,1,1,1);
	sunColor.xyz = normalize(Vibrance(L_hemi_color.rgb,2));

	// [DA_PORT] ЦВЕТ ЛУЧЕЙ ОТ НЕБА У ГОРИЗОНТА (r__shafts_sky). Ноль — как было.
	//
	// Откуда желтизна. Строка выше берёт цвет ПОЛУСФЕРЫ, удваивает насыщенность и
	// НОРМАЛИЗУЕТ вектор: от неба остаётся чистый оттенок на полную силу, независимо от его
	// настоящей яркости. Любой тёплый подтон превращается в жёлтый, а накладывается это по
	// всему экрану — вдали без преград лучи работают как цветная дымка.
	//
	// А наш туман красится небом У ГОРИЗОНТА (r__fog_sky). Два источника тянут в разные
	// стороны, и на дистанции они спорят друг с другом: мгла холодная, лучи жёлтые.
	//
	// Главное правило тумана — он обязан совпадать с небом на горизонте. Раз лучи вдали
	// ведут себя как туман, к ним оно относится в той же мере. Берём тот же источник.
	[branch] if ( da_shafts.x > 0.001f )
	{
		// Направление на солнце, прижатое к горизонту: рассеяние идёт вдоль почти
		// горизонтального луча, и красить его должен цвет у горизонта, а не зенит.
		float3 sd = normalize( float3( L_sun_dir_w.x, L_sun_dir_w.y * 0.15f, L_sun_dir_w.z ) );
		float3 s0 = sky_s0.SampleLevel( smp_rtlinear, sd, 6.0f );
		float3 s1 = sky_s1.SampleLevel( smp_rtlinear, sd, 6.0f );
		float3 sky = env_color.xyz * lerp( s0, s1, env_color.w );

		// Нормализуем так же, как строка выше: здесь важен ОТТЕНОК, а силу задаёт
		// sun_shafts_intensity. Иначе яркость неба сложилась бы с ней дважды.
		sky = normalize( max( sky, 0.001f ) );
		sunColor.xyz = lerp( sunColor.xyz, sky, saturate( da_shafts.x ) );
	}
	

	outColor = cScreen+cSunShafts.xyzz*max_density.x*4*SSParamsDISPLAY.x*sunColor*(1-cScreen);
		
	outColor = blendSoftLight(outColor,sunColor*fShaftsMask*0.5+0.5);
	
	return outColor;
	
#else

	return sScene.Sample(smp_nofilter,INStruct.texCoord0.xy);
#endif //USE_SSHAFTS
}