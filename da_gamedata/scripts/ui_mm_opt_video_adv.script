	-- [DA_PORT] Дождь. Порядок пунктов задан осознанно: сперва включение, потом качество, потом
	-- дальность, и в конце — сам дождь. Все действуют сразу, без перезапуска.
	_st = xml:InitStatic("video_adv:templ_header", nil)
	xml:InitStatic("video_adv:cap_grp_rain", _st)
	table.insert(handler.m_preconditions, {func=mode_ge_2, control=_st})

	_st = xml:InitStatic("video_adv:templ_item", nil)
	xml:InitStatic("video_adv:cap_puddles", _st)
