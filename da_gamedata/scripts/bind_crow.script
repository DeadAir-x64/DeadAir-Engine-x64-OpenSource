--------------------------------------------------------------------------------
-- Crow binding ----------------------------------------------------------------
-- Made by Peacemaker ----------------------------------------------------------
-- 25.12.07 --------------------------------------------------------------------
--------------------------------------------------------------------------------
crow_storage = {}
crow_counter = 0
-- Standart function for object binding
function bind(obj)
--    local new_binder = crow_binder(obj)
    obj:bind_object(crow_binder(obj))
end
--------------------------------------------------------------------------------
-- Class "crow_binder"
--------------------------------------------------------------------------------
class "crow_binder" (object_binder)
-- Class constructor
function crow_binder:__init(obj) super(obj)
    self.body_timer = 0
end
-- Class update
function crow_binder:update(delta)
-- standart update
    object_binder.update(self, delta)
	if not (self.object:alive()) then
		if (self.body_timer<=time_global()-120000) and (self.body_timer~=0) then
			-- [DA_PORT] Через safe_release_manager, а не напрямую.
			--
			-- Было: alife():release(alife_object(id), true) прямо отсюда — обход того самого механизма,
			-- который автор мода написал ровно для этого случая. В шапке safe_release_manager он
			-- объяснил: после освобождения серверного объекта биндер живёт ещё несколько кадров, и тогда
			-- серверного объекта уже нет, а игровой ещё есть. Менеджер поэтому сначала уводит объект в
			-- оффлайн и освобождает лишь когда биндер исчез. Прямой вызов эту защиту пропускал — и
			-- получалось обращение к удалённому объекту, падение «исполнение по адресу
			-- 0000000000000000» без машинного стека.
			--
			-- ⚠️ Таймер НЕ сбрасываем, и это сверено с Anomaly: там ровно тот же код и тоже без сброса.
			-- Менеджер удаляет не сразу — ждёт исчезновения биндера и повторяет попытки. Пока условие
			-- здесь истинно, повторный вызов лишь обновляет запись в его таблице, это дёшево. Сброс же
			-- закрыл бы возможность повторить, если запись потеряется.
			printf("releasing object ["..self.object:name().."]")
			local se_obj = alife_object(self.object:id())
			if (se_obj) then
				safe_release_manager.release(se_obj)
			end
		end
		--Alundaio		
		local knife_equipped = false
	
		if (db.actor) then
			local obj = db.actor:active_item()
			if (obj) then
				knife_equipped = string.match(tostring(obj:section()),"knife")
			end
		end
		
		if (knife_equipped) then
			if (knife_manager.get_condition() < 0.15) then
				self.object:set_callback(callback.use_object, nil)
				self.object:set_tip_text(game.translate_string("st_body_knife_bad"))
			elseif (not knife_manager.can_loot(self.object:section())) then
				self.object:set_callback(callback.use_object, nil)
				self.object:set_tip_text(game.translate_string("st_body_knife_weak"))
			else
				self.object:set_callback(callback.use_object, self.use_callback, self)
				self.object:set_tip_text(game.translate_string("st_screen_field_dress"))
			end
		else
			self.object:set_callback(callback.use_object, nil)
			self.object:set_tip_text(game.translate_string("st_body_knife_needed"))
		end
		--Alundaio
	end
end

function crow_binder:use_callback(obj, who)
	-- Alundaio
	if (itms_manager) then itms_manager.monster_on_actor_use_callback(obj,who) end
	-- Alundaio
end

-- Reload object
function crow_binder:reload(section)
    object_binder.reload(self, section)
end
-- Reinitialize object
function crow_binder:reinit()
    self.body_timer = 0
    object_binder.reinit(self)
	db.storage[self.object:id()] = {}
	self.st = db.storage[self.object:id()]
end
-- Net spawn
function crow_binder:net_spawn(sobject)
    if not(object_binder.net_spawn(self, sobject)) then
        return false
    end
    db.add_obj(self.object)
    bind_crow.crow_storage[self.object:id()] = self.object:id()
	bind_crow.crow_counter = bind_crow.crow_counter + 1
    self.object:set_callback(callback.death, self.death_callback, self)
    return true
end
-- Net destroy
function crow_binder:net_destroy()
    self.object:set_callback(callback.death, nil)

	-- [DA_PORT] Уменьшаем счётчик, ТОЛЬКО если ворона в нём ещё числится.
	--
	-- Счётчик живых ворон читает спавнер (sr_crow_spawner): пока он меньше предела
	-- max_crows_on_level, тот подсаживает новых. А уменьшался он у нас ДВАЖДЫ за одну ворону —
	-- сначала в death_callback при смерти, потом в net_destroy при удалении. Счёт уходил ниже
	-- истины, спавнер считал, что ворон мало, и досыпал ещё. Отсюда их сотни в логах и
	-- постоянный поток удалений.
	--
	-- Сверено с Anomaly: там ровно эта проверка в обоих местах.
	if bind_crow.crow_storage[self.object:id()] then
		bind_crow.crow_storage[self.object:id()] = nil
		bind_crow.crow_counter = bind_crow.crow_counter > 0 and bind_crow.crow_counter - 1 or 0
	end
    db.del_obj(self.object)
    object_binder.net_destroy(self)
end
-- Crow death callback
function crow_binder:death_callback(victim, who)
    self.body_timer = time_global()

	-- [DA_PORT] Та же проверка, см. net_destroy: иначе одна ворона уменьшает счётчик дважды.
	if bind_crow.crow_storage[self.object:id()] then
		bind_crow.crow_storage[self.object:id()] = nil
		bind_crow.crow_counter = bind_crow.crow_counter > 0 and bind_crow.crow_counter - 1 or 0
	end
end
-- Standart function for save
function crow_binder:net_save_relevant()
	return true
end
-- Saving crow
function crow_binder:save(stpk)
	set_save_marker(stpk, "save", false, "crow_binder")
	object_binder.save(self, stpk)
	xr_logic.save_obj(self.object, stpk)
	stpk:w_u32(self.body_timer)
	set_save_marker(stpk, "save", true, "crow_binder")
end
-- Loading crow
function crow_binder:load(reader)
	set_save_marker(reader, "load", false, "crow_binder")
	object_binder.load(self, reader)
	xr_logic.load_obj(self.object, reader)
	self.body_timer = reader:r_u32()
	set_save_marker(reader, "load", true, "crow_binder")
end
