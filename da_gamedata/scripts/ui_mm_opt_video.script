class "opt_video" (CUIWindow)

function opt_video:__init() super()
end

function opt_video:__finalize()

end

function opt_video:InitControls(x, y, xml, handler)

	self:SetWndPos(vector2():set(x,y))
	self:SetWndSize(vector2():set(738,416))
	self:SetAutoDelete(true)

--	self.bk = xml:InitFrame			("frame", self)

	xml:InitStatic					("tab_video:cap_window_mode",		self)
	xml:InitComboBox				("tab_video:list_window_mode",		self)

	-- [DA_PORT] Upscaling: which one, and how hard. Replaces the separate FSR 1.0 preset, FSR 2 quality
	-- list and raw render-scale percentage. The engine side writes the per-vendor variables and the
	-- render scale together, so these two controls cannot be put into a contradictory state.
	-- [DA_PORT] frame-rate cap, right under the resolution
	xml:InitStatic("tab_video:cap_fps_limit", self)
	handler.combo_fps_limit = xml:InitComboBox("tab_video:list_fps_limit", self)
	xml:InitStatic("tab_video:cap_v_sync", self)
	xml:InitCheck("tab_video:check_v_sync", self)
	xml:InitStatic("tab_video:cap_v_sync_note", self)

	xml:InitStatic("tab_video:cap_grp_scaling", self)
	xml:InitStatic("tab_video:cap_upscaler", self)
	handler.combo_upscaler = xml:InitComboBox("tab_video:list_upscaler", self)
	-- [DA_PORT] registered so the quality steps can be greyed out for the choices that have none
	handler:Register(handler.combo_upscaler, "list_upscaler")

	-- [DA_PORT] The caption is kept as well, not just the list: the row is hidden whole for the choices
	-- that have no quality steps, and a label left hanging over an empty space reads worse than the
	-- greyed-out control it replaced.
	handler.cap_upscaler_quality = xml:InitStatic("tab_video:cap_upscaler_quality", self)
	handler.combo_upscaler_quality = xml:InitComboBox("tab_video:list_upscaler_quality", self)

	-- [DA_PORT] Multisampling, for players running no temporal filter at all. It occupies the SAME row
	-- as the quality steps above: the two are mutually exclusive by construction - quality belongs to a
	-- reconstructing upscaler, this belongs to "off" - so one slot serves both and the rows below stay
	-- where they are. OnUpscalerChanged decides which of the two is visible.
	--
	-- Stored on the handler rather than on self for the same reason combo_upscaler is: OnUpscalerChanged
	-- lives on the options dialog, and looking these up under dlg_video found nil every time.
	handler.cap_msaa = xml:InitStatic("tab_video:cap_msaa", self)
	handler.combo_msaa = xml:InitComboBox("tab_video:list_msaa", self)

	-- [DA_PORT] ѕотолок теневых ламп ∆»¬®“ ¬ќ ¬ Ћјƒ ≈ ѕ–ќ»«¬ќƒ»“≈Ћ№Ќќ—“», не здесь.
	-- ѕрив€зка осталась после переноса и каждый запуск писала в лог, что узла нет. ’уже того,
	-- InitComboBox по отсутствующему узлу возвращает nil, и этот nil затирал бы рабочую ссылку,
	-- выставленную ui_mm_opt_performance.script, Ч в зависимости от того, кто отработал последним.

	-- [DA_PORT] anisotropy moved here from Advanced: an image-quality knob, not a frame-rate one
	xml:InitStatic("tab_video:cap_aniso", self)
	self.aniso_track = xml:InitTrackBar("tab_video:track_aniso", self)
	self.aniso_val = xml:InitStatic("tab_video:cap_aniso_val", self)

	xml:InitStatic					("tab_video:cap_resolution",		self)
	xml:InitComboBox				("tab_video:list_resolution",		self)

	xml:InitStatic					("tab_video:cap_preset",			self)
	handler.combo_preset			= xml:InitComboBox("tab_video:list_presets",	self)
	handler:Register				(handler.combo_preset,				"combo_preset")

	xml:InitStatic("tab_video:cap_grp_screen", self)
	xml:InitStatic					("tab_video:cap_renderer",			self)
	handler.combo_renderer			= xml:InitComboBox("tab_video:list_renderer",		self)
	handler:Register				(handler.combo_renderer, "combo_renderer")

	btn		= xml:Init3tButton		("tab_video:btn_advanced",	self)
	handler:Register				(btn, "btn_advanced_graphic")

	xml:InitStatic("tab_video:cap_grp_da_tune", self)
	-- [DA_PORT] ѕереход к экранной подгонке: обзор оружи€, его положение и цветокоррекци€
	-- настраиваютс€ в самой игре, потому что меню закрывает собой ровно ту картинку,
	-- ради которой их и крут€т. ќбработчик Ч options_dialog:OnBtnDaTune.
	btn		= xml:Init3tButton		("tab_video:btn_da_tune",	self)
	handler:Register				(btn, "btn_da_tune")
	-- [DA_PORT] √руппа раскладки интерфейса (pillarbox / safe zone / широка€ разметка).
	-- ÷елочисленные крутилки движка: галки читаютс€ через GetBool (умеет только int), ползунок
	-- объ€влен is_integer и читаетс€ GetIValue в ui_mm_opt_main.script Ч там он в списке int_track.
	xml:InitStatic("tab_video:cap_grp_ui_layout", self)
	xml:InitStatic("tab_video:cap_ui_pillarbox", self)
	xml:InitCheck("tab_video:check_ui_pillarbox", self)
	xml:InitStatic("tab_video:cap_ui_safe_zone", self)
	self.ui_safe_zone_track = xml:InitTrackBar("tab_video:track_ui_safe_zone", self)
	self.ui_safe_zone_val = xml:InitStatic("tab_video:cap_ui_safe_zone_val", self)
end
