options = {
	-- minimal distance from actor to draw helmet (increase it if helmet disapear when running / jumping)
	cam_dist = 5.4,
	-- [DA_PORT] 0.45 = 4500 mSv: the blur effectively never showed up, the actor dies long before.
	-- The HUD reads millisieverts as radiation*10000 (itms_manager.script), so this is 600 mSv.
	-- Raise it to delay the blur, lower it to bring it on earlier.
	radiation_ppe_threshold = 0.06,

	outfits = {
		-- texture to use when wearing the exo outfit
--		exo_outfit = "helm_respirator",
		-- texture to use when wearing the scientific outfit
		scientific_outfit = "helm_scientific",
		ecologist_red_outfit = "helm_scientific",
		ecologist_green_outfit = "helm_scientific",
		ghillie_outfit = "helm_ghillie",
	},
	helmets = {
		helm_respirator = "helm_respirator",
		helm_m40 = "helm_respirator",
		helm_hardhat = "helm_hardhat",
		helm_tactic = "helm_tactic",
		helm_battle = "helm_battle",
	},
	health = {
		-- health level for heavy injuring sounds
		level1 = 0.5,
		-- health level for light injuring sounds
		level2 = 0.15,
		-- little hit effect (played on every hit > little_delta)
		little_delta = 17,
		little_ppe = "amk_shoot.ppe",
		-- middle hit effect (played in addition of little effect, anm and snd randomly chosen)
		middle_delta = 44,
		middle_anm = {"shell_shock","hit_front","hit_right","hit_back","hit_left","hit_front_left","hit_back_left","hit_front_right","hit_back_right"},
		middle_snd = {"pain_2","pain_3","pain_5","pain_6","pain_7","pain_8"},
		-- huge hit effect (played in addition of little effect, anm and snd randomly chosen)
		huge_delta = 68,
		huge_ppe = "total_recall.ppe",
		huge_anm = {"head_shot","fusker"},
		huge_snd = {"pain_4","pain_1","hit_5","hit_6"},
		-- hit drop weapon probability (0-1)
		drop_wnp_prob = 0.08,
		-- non dropable items
		no_drop_wnp = {bolt = true},
		injury_snd = {
			_1_0 = 2825,
			_1_1 = 2612,
			_1_2 = 2783,
			_1_3 = 2821,
			_1_4 = 3048,
			_2_1 = 3331,
			_2_2 = 3785,
			_2_3 = 2989,
			_2_4 = 4066,
		},
	},
	speed = {
		-- minimal speed for actor being treated as "running"
		mini = 0.5,
		-- speed time increase per update (when running)
		inc = 0.05,
		-- speed time decrease per update (when not running)
		dec = 0.28,
		-- minimal speed time for playing breath sounds (when no gasmask)
		time_mini = 6,
		-- play breath sounds (when no gasmask) when stamina is below this level
		stamina = 0.4,
		-- on actor hit, actor_speed_time += delta_health*k_health
		k_health = 0.28,
		-- actor_speed_time += bleeding*k_bleed
		k_bleed = 1.33,
	},
}

wpn_fx = {}

function update_fx()

	local kp = 1.2
	local ks = 0.9
	local k5 = 1.2
	local k7 = 0.9

	if db.actor:has_info("perk_short_range") then
		kp = 0.5
		ks = 0.5
	end
	if db.actor:has_info("perk_long_range") then
		k5 = 0.7
		k7 = 0.7
	end

	wpn_fx = {	
		pistol = {
			s = {1},
			r = 0,
			e = { {1.7*kp}, {0.6*kp}, {0.8*kp, 1}, {3.7*kp, 0}, {2.1*kp, 0}, {0} },
			p = {},
		},
		
		shotgun = {
			s = {3, 4},
			r = 1,
			e = { {1.4*ks}, {1.4*ks}, {1.1*ks, 1}, {2.1*ks}, {4.1*ks}, {4.4*ks} },
			p = {},
		},
		
		rifle_5 = {
			s = {1, 3},
			r = 2,
			e = { {0.6*k5}, {0.9*k5, 1}, {0.9*k5, 1}, {1*k5}, {3.5*k5, 0}, {0.2*k5} },
			p = {},
		},
		
		rifle_7 = {
			s = {3, 4, 3},
			r = 2,
			e = { {0.5*k7, 1}, {1.2*k7, 1}, {0.9*k7, 1}, {1.2*k7}, {4.3*k7, 0}, {0.7*k7} },
			p = {},
		},
	}
end

local kp = 0.7
local ks = 0.9
local k5 = 1.2
local k7 = 0.9


--		!!!IMPORTANT!!!
-- for ppe and anm effect, use id > 8000
-- "camera_effects\\pripyat_horror1.anm",

