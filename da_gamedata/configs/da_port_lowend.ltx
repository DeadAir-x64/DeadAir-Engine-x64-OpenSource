; Dead Air x64 — набор настроек для слабых машин.
;
; Применить из консоли:   cfg_load da_port_lowend.ltx
; Вернуться к своим:      выставить настройки в меню, либо cfg_load user.ltx
;
; Это ОТДЕЛЬНЫЙ файл, он не перекрывает штатные rspec_*.ltx мода — команда `_preset Low` по-прежнему
; работает как раньше. Здесь собрано то, что на слабом железе даёт больше всего кадров за наименьшую
; потерю в картинке, включая две возможности, которых в оригинальном моде не было (масштаб рендера и
; темпоральное сглаживание).
;
; Порядок в файле — по убыванию отдачи. Если хочется вернуть часть качества, снимать сверху вниз.

; --- Главный рычаг -------------------------------------------------------------------------------
; Сцена рендерится в 75% от разрешения окна и растягивается бикубикой с компенсацией мип-уровней.
; Интерфейс и прицел остаются в родном разрешении. Ниже 60 картинка начинает заметно мылиться.
r__render_scale 75

; --- Сглаживание ---------------------------------------------------------------------------------
; MSAA умножает работу на краях геометрии; темпоральное сглаживание стоит один полноэкранный проход.
; На слабой машине это прямая замена — и заодно оно убирает мерцание травы, которого на низких
; настройках больше.
r3_msaa st_opt_off
r__taa 1
r__taa_sharp 30

; --- Тени ----------------------------------------------------------------------------------------
; Размер карты теней стоит квадратично: 1536 против 2048 — это примерно вдвое меньше пикселей.
r2_smap_size 1536
r2_sun_quality st_opt_low
r2_sun_details off
r2_sun_near_border 0.75

; --- Затенение и объёмный свет -------------------------------------------------------------------
; Полноэкранные проходы, на слабых видеокартах заметны сразу.
r2_ssao_mode disabled
r2_volumetric_lights off

; --- Трава и детали ------------------------------------------------------------------------------
; Радиус травы влияет и на видеокарту, и на процессор — трава пересчитывается при движении.
r__detail_radius 49
r__detail_density 0.5

; --- Дополнительные выборки ----------------------------------------------------------------------
; Каждый пункт — лишние чтения буфера глубины на пиксель.
r2_soft_water off
r2_soft_particles off
r2_steep_parallax off
r2_detail_bump off

; --- Прочее --------------------------------------------------------------------------------------
r2_dof_enable off
r2_mblur 0

; Анизотропия НЕ понижается — она здесь не роскошь. Масштаб рендера выше сдвигает выбор мип-уровней в
; минус (иначе текстуры приезжают пред-замыленными), а при отрицательном сдвиге трилинейная фильтрация
; недосэмплирует: вместо мыла получается мерцание, сильнее всего на земле под острым углом. Отсчёты
; вдоль длинной оси пятна — единственное, что делает этот сдвиг безопасным, и стоят они несопоставимо
; дешевле того, что этот файл уже сэкономил.
r__tf_aniso 16
