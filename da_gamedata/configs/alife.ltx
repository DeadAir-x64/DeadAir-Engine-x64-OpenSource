[alife]
    schedule_min				= 1										; milliseconds
    schedule_max				= 1										; milliseconds
    process_time				= 900									; microseconds
    update_monster_factor		= 0.1
    time_factor					= 10;	1;	;396.0;скорость для демонстрации смены дня и ночи
    normal_time_factor			= 10;	животные в оффлайне перемещаются со скоростью, делённой на этот фактор (чтобы не бегали очень быстро)
    ; [DA_PORT] ПРОБОВАЛИ 150 И ВЕРНУЛИ 250 -- решение принято, не повторять.
;
; 150 метров советуют в наборах оптимизации для Anomaly: меньше NPC в онлайне -- меньше
; работы планировщику. Выигрыш настоящий, но платить за него приходится ощущением Зоны:
; бои начинаются ближе, вокруг заметно малолюднее. Для выживалки это дороже, чем
; выигранные кадры, тем более что после правок движка планировщик и так упал до 2.5 мс.
;
; Если понадобится сравнить ещё раз -- перезапуск не нужен, значение меняется на ходу:
; alife():set_switch_distance(150)
    switch_distance				= 250									; metres
    switch_factor				= 0.1											;
    start_time					= 09:00:00
    start_date					= 25.10.2015
    autosave_interval			= 00:05:00
    delay_autosave_interval		= 00:00:30
	; [DA_PORT] 5 вместо 20: столько объектов ALife обсчитывается за ОДИН такт симуляции.
; Меньше порция -- мельче выбросы кадра. Цена НЕ нулевая: офлайновый мир живёт вчетверо
; медленнее, отряды дольше идут по карте, события за кадром разворачиваются реже.
	objects_per_update			= 5
	start_game_callback			= _G.start_game_callback					; on starting new game or loading saved one
